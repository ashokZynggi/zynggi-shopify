<section class="section quality-process-section bg-{{ section.settings.bg }}">
  <div class="container">
    <div class="section__head"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div>{%- if section.settings.cta_link != blank -%}<a class="btn btn--outline" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>{%- endif -%}</div>
    <div class="steps" style="--n:{{ section.blocks.size | at_most: 6 }}">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.mobile_image != blank -%}
            <picture>
              {%- if block.settings.mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 700 }}">
              {%- endif -%}
              {%- assign step_image = block.settings.image | default: block.settings.mobile_image -%}
              {{ step_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}
            </picture>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Quality process steps","settings":[
 {"type":"text","id":"heading","label":"Heading","default":"From whole spice to your kitchen"},
 {"type":"textarea","id":"subheading","label":"Subheading","info":"Only describe processes the brand actually follows."},
 {"type":"text","id":"cta_text","label":"Button text","default":"Our quality promise"},
 {"type":"url","id":"cta_link","label":"Button link"},
 {"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"}],"default":"white"}],
"blocks":[{"type":"step","name":"Step","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image","info":"Optional portrait/square image used only on phones."},{"type":"text","id":"title","label":"Title","default":"Carefully sourced"},{"type":"textarea","id":"text","label":"Description","default":"[PROCESS DETAIL FROM CLIENT]"}]}],
"presets":[{"name":"Quality process steps","blocks":[{"type":"step","settings":{"title":"Carefully sourced"}},{"type":"step","settings":{"title":"Quality checked"}},{"type":"step","settings":{"title":"Carefully processed"}},{"type":"step","settings":{"title":"Hygienically packed"}},{"type":"step","settings":{"title":"Delivered fresh"}}]}]}
{% endschema %}
<style>
  /* =========================================
     Zynggi - Quality Process Section
     ========================================= */

  .quality-process-section {
    padding-top: 35px !important;
    padding-bottom: 35px !important;
  }

