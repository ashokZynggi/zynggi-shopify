    .quality-process-section .steps {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
    }

.quality-process-section .step {
  flex: 0 0 82px;
  scroll-snap-align: start;
}
    .quality-process-section .step { position: relative; padding: 6px 4px 8px; border-radius: 12px; }
    .quality-process-section .step::before {
      position: absolute; top: 5px; left: 5px; z-index: 1;
      width: 18px; height: 18px; font-size: 10px; margin: 0;
    }
    .quality-process-section .step img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: contain;
      object-position: center;
      display: block;
      margin: 0 auto 6px;
      border-radius: 10px;
      background: #f5ead9;
    }
    .quality-process-section .step h3 { font-size: 10px; line-height: 1.15; overflow-wrap: anywhere; }
    .quality-process-section .step p { display: none; }
  }
</style>