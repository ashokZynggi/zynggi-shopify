<section class="zynggi-salesman-login">
  <div class="zynggi-login-card">

    <div class="zynggi-login-header">
      <div class="zynggi-login-logo">
        ZYNGGI
      </div>

      <h1>Salesman Login</h1>

      <p>
        Login to manage shops and take orders.
      </p>
    </div>

    <form id="zynggiSalesmanLoginForm">

      <div class="zynggi-field">
        <label for="salesmanEmail">
          Email
        </label>

        <input
          type="email"
          id="salesmanEmail"
          name="email"
          placeholder="Enter your email"
          autocomplete="email"
          required
        >
      </div>

      <div class="zynggi-field">
        <label for="salesmanPassword">
          Password
        </label>

        <input
          type="password"
          id="salesmanPassword"
          name="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
        >
      </div>

      <button
        type="submit"
        id="salesmanLoginButton"
        class="zynggi-login-button"
      >
        Login
      </button>

      <div
        id="salesmanLoginMessage"
        class="zynggi-login-message"
        aria-live="polite"
      ></div>

    </form>

  </div>
</section>

<style>
  .zynggi-salesman-login {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    background:
      linear-gradient(
        135deg,
        #24170e 0%,
        #3a2414 50%,
        #1b120c 100%
      );
  }

  .zynggi-login-card {
    width: 100%;
    max-width: 460px;
    padding: 42px;
    background: #fffaf3;
    border-radius: 18px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .zynggi-login-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .zynggi-login-logo {
    margin-bottom: 14px;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 4px;
    color: #8b5e34;
  }

  .zynggi-login-header h1 {
    margin: 0 0 10px;
    font-size: 32px;
    line-height: 1.2;
    color: #24170e;
  }

  .zynggi-login-header p {
    margin: 0;
    color: #75685e;
    font-size: 15px;
    line-height: 1.6;
  }

  .zynggi-field {
    margin-bottom: 20px;
  }

  .zynggi-field label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #3a2a1e;
  }

  .zynggi-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 14px 15px;
    border: 1px solid #d8c9ba;
    border-radius: 10px;
    background: #ffffff;
    color: #24170e;
    font-size: 15px;
    outline: none;
    transition: 0.2s ease;
  }

  .zynggi-field input::placeholder {
    color: #9a8c80;
  }

  .zynggi-field input:focus {
    border-color: #9a6a3a;
    box-shadow: 0 0 0 3px rgba(154, 106, 58, 0.12);
  }

  .zynggi-login-button {
    width: 100%;
    padding: 15px 20px;
    border: 0;
    border-radius: 10px;
    background: #8b5e34;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .zynggi-login-button:hover {
    background: #6f4726;
  }

  .zynggi-login-button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .zynggi-login-message {
    min-height: 22px;
    margin-top: 16px;
    text-align: center;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .zynggi-salesman-login {
      min-height: 65vh;
      padding: 40px 16px;
    }

    .zynggi-login-card {
      padding: 30px 22px;
      border-radius: 14px;
    }

    .zynggi-login-header h1 {
      font-size: 28px;
    }

    .zynggi-login-logo {
      font-size: 23px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const SUPABASE_URL =
      "https://txiwtrmlbgticffnickx.supabase.co";

    const SUPABASE_PUBLISHABLE_KEY =
      "sb_publishable_GICrvn3syGJ6eOcOqeVbzg_p8cx5Jmq";

    let sessionExpiryTimer = null;

    function clearBusinessSession() {
      try {
        sessionStorage.removeItem("zynggi_salesman_access_token"); localStorage.removeItem("zynggi_salesman_access_token");
        localStorage.removeItem("zynggi_salesman_refresh_token");
        localStorage.removeItem("zynggi_salesman");
        localStorage.removeItem("zynggi_salesman_user_id");
      } catch (error) {
        console.warn("Unable to clear Zynggi session storage.", error);
      }
    }

    function getJwtExpiry(token) {
      try {
        const payload = JSON.parse(
          atob(token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/"))
        );
        return Number(payload.exp || 0) * 1000;
      } catch (error) {
        return 0;
      }
    }

    function scheduleSessionExpiry(token) {
      const expiresAt = getJwtExpiry(token);
      if (!expiresAt) return true;
      const remaining = expiresAt - Date.now();
      if (remaining <= 0) return false;

      sessionExpiryTimer = window.setTimeout(function () {
        clearBusinessSession();
        window.location.replace("/pages/zynggi-business");
      }, remaining + 500);

      return true;
    }

    const loginForm =
      document.getElementById("zynggiSalesmanLoginForm");

    const loginButton =
      document.getElementById("salesmanLoginButton");

    const message =
      document.getElementById("salesmanLoginMessage");

    if (!loginForm || !loginButton || !message) {
      return;
    }

    loginForm.addEventListener("submit", async function (event) {
      event.preventDefault();

      const email =
        document.getElementById("salesmanEmail").value.trim();

      const password =
        document.getElementById("salesmanPassword").value;

      message.textContent = "";
      message.style.color = "";

      loginButton.disabled = true;
      loginButton.textContent = "Logging in...";

      try {
        const authResponse = await fetch(
          SUPABASE_URL + "/auth/v1/token?grant_type=password",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "apikey": SUPABASE_PUBLISHABLE_KEY
            },
            body: JSON.stringify({
              email: email,
              password: password
            })
          }
        );

        const authData = await authResponse.json();

        if (!authResponse.ok) {
          throw new Error(
            authData.error_description ||
            authData.msg ||
            authData.message ||
            "Invalid email or password."
          );
        }

        if (!authData.access_token || !authData.user) {
          throw new Error(
            "Login failed. Please try again."
          );
        }

        const salesmanResponse = await fetch(
          SUPABASE_URL +
            "/rest/v1/salesmen" +
            "?select=id,salesman_code,name,mobile,area,role,status" +
            "&user_id=eq." +
            encodeURIComponent(authData.user.id) +
            "&limit=1",
          {
            method: "GET",
            headers: {
              "apikey": SUPABASE_PUBLISHABLE_KEY,
              "Authorization":
                "Bearer " + authData.access_token
            }
          }
        );

        const salesmanData =
          await salesmanResponse.json();

        if (!salesmanResponse.ok) {
          throw new Error(
            salesmanData.message ||
            "Unable to verify salesman account."
          );
        }

        const salesman =
          Array.isArray(salesmanData) &&
          salesmanData.length > 0
            ? salesmanData[0]
            : null;

        if (!salesman) {
          throw new Error(
            "This account is not registered as a Zynggi salesman."
          );
        }

        if (salesman.status !== "active") {
          throw new Error(
            "Your salesman account is currently inactive."
          );
        }

        localStorage.setItem(
          "zynggi_salesman",
          JSON.stringify(salesman)
        );

        localStorage.setItem(
          "zynggi_salesman_user_id",
          authData.user.id
        );

        sessionStorage.setItem(
          "zynggi_salesman_access_token",
          authData.access_token
        );

        if (!scheduleSessionExpiry(authData.access_token)) {
          clearBusinessSession();
          throw new Error("Your session has expired. Please sign in again.");
        }

        message.style.color = "#287a3e";
        message.textContent =
          "Login successful. Opening dashboard...";

        window.location.href =
          "/pages/salesman-dashboard";

      } catch (error) {
        console.error(
          "Zynggi Salesman Login Error:",
          error
        );

        message.style.color = "#b42318";

        message.textContent =
          error.message ||
          "Login failed. Please try again.";

        loginButton.disabled = false;
        loginButton.textContent = "Login";
      }
    });
  });
</script>

{% schema %}
{
  "name": "Zynggi Salesman Login",
  "settings": [],
  "presets": [
    {
      "name": "Zynggi Salesman Login"
    }
  ]
}
{% endschema %}