<section class="section bg-{{ section.settings.bg }}"><div class="container" style="text-align:center;max-width:760px"><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><a class="btn btn--accent" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a></div></section>
{% schema %}
{"name":"CTA banner","settings":[{"type":"text","id":"heading","label":"Heading","default":"Ready to cook?"},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"cta_text","label":"Button text","default":"Shop our products"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"},{"value":"red","label":"Chilli red"}],"default":"green"}],"presets":[{"name":"CTA banner"}]}
{% endschema %}
