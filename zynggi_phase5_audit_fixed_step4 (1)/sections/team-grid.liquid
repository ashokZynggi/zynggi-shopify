<section class="section bg-{{ section.settings.bg }}"><div class="container">
  <h2>{{ section.settings.heading }}</h2>
  <div class="grid grid--4">{%- for b in section.blocks -%}<div {{ b.shopify_attributes }}>{%- if b.settings.photo != blank -%}{{ b.settings.photo | image_url: width: 500 | image_tag: loading: 'lazy', alt: b.settings.name, style: 'border-radius:16px;aspect-ratio:4/5;object-fit:cover;width:100%' }}{%- endif -%}<h3 style="margin-top:12px;margin-bottom:0">{{ b.settings.name }}</h3><p class="muted" style="margin:0 0 8px">{{ b.settings.role }}</p><p style="font-size:.95rem">{{ b.settings.bio }}</p></div>{%- endfor -%}</div>
</div></section>
{% schema %}
{"name":"Team / founders","settings":[{"type":"text","id":"heading","label":"Heading","default":"People behind the flavour"},{"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"}],"default":"white"}],"blocks":[{"type":"member","name":"Person","settings":[{"type":"image_picker","id":"photo","label":"Photo"},{"type":"text","id":"name","label":"Name","default":"[NAME]"},{"type":"text","id":"role","label":"Role"},{"type":"textarea","id":"bio","label":"Short bio"}]}],"presets":[{"name":"Team / founders"}]}
{% endschema %}
