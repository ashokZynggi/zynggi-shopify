<section class="section bg-{{ section.settings.bg }}">
  <div class="container">
    <div class="section__head"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div></div>
    {%- if section.blocks.size > 0 -%}
    <div class="scroller" style="grid-auto-columns:minmax(280px,calc((100% - 48px) / 3))">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{% render block %}{%- continue -%}{%- endif -%}
        {%- assign s = block.settings -%}
        <figure class="quote" style="margin:0" {{ block.shopify_attributes }}>
          <div class="stars" role="img" aria-label="{{ s.rating }} out of 5 stars">{%- for i in (1..s.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</div>
          <blockquote style="margin:0">{{ s.text }}</blockquote>
          {%- if s.photo != blank -%}{{ s.photo | image_url: width: 480 | image_tag: loading: 'lazy', alt: s.name, style: 'border-radius:12px' }}{%- endif -%}
          <figcaption style="margin-top:auto"><strong>{{ s.name }}</strong>{%- if s.verified -%} <span class="verified">{% render 'icon', name: 'check' %} Verified purchase</span>{%- endif -%}{%- if s.product != blank -%}<br><span class="muted" style="font-size:.9rem">{{ s.product }}</span>{%- endif -%}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
    {%- elsif request.design_mode -%}<p class="muted">Add real customer testimonials as blocks, or place your review app's block here.</p>{%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Customer reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"Real food. Real people."},{"type":"text","id":"subheading","label":"Subheading"},{"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"}],"default":"white"}],
"blocks":[{"type":"review","name":"Testimonial","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"default":5},{"type":"textarea","id":"text","label":"Review text"},{"type":"text","id":"name","label":"Customer name"},{"type":"text","id":"product","label":"Product purchased"},{"type":"checkbox","id":"verified","label":"Verified purchase","default":false},{"type":"image_picker","id":"photo","label":"Customer photo"}]},{"type":"@app"}],
"presets":[{"name":"Customer reviews"}]}
{% endschema %}
