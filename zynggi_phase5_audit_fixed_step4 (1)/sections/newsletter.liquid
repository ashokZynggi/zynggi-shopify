<section class="section bg-{{ section.settings.bg }}">
  <div class="container news">
    <div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
    <div>
      {%- form 'customer', class: 'newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}<p class="form-msg form-msg--ok" role="status">Thanks for subscribing.</p>{%- endif -%}
        {%- if form.errors -%}<p class="form-msg form-msg--err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <label class="visually-hidden" for="nl-{{ section.id }}">Email</label>
          <input id="nl-{{ section.id }}" class="input" style="flex:1;min-width:200px" type="email" name="contact[email]" placeholder="Your email address" required autocomplete="email">
          <button class="btn btn--accent" type="submit">{{ section.settings.button }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Get more flavour in your inbox"},{"type":"textarea","id":"text","label":"Text","default":"Recipes, cooking ideas, product launches and special offers."},{"type":"text","id":"button","label":"Button text","default":"Subscribe"},{"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"},{"value":"red","label":"Chilli red"}],"default":"red"}],
"presets":[{"name":"Newsletter"}]}
{% endschema %}
