<section class="section bg-warm">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <div class="grid grid--4">
      {%- for b in section.blocks -%}
        <div class="benefit" {{ b.shopify_attributes }}><div class="usp__ic">{% render 'icon', name: b.settings.icon %}</div><h3>{{ b.settings.title }}</h3><p style="margin:0">{{ b.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Why you'll love it","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why you'll love it"}],"max_blocks":4,
"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"leaf","label":"Leaf"},{"value":"flame","label":"Flame"},{"value":"shield","label":"Shield"},{"value":"box","label":"Box"},{"value":"sparkle","label":"Sparkle"}],"default":"leaf"},{"type":"text","id":"title","label":"Title","default":"Premium ingredients"},{"type":"text","id":"text","label":"Text","default":"Carefully selected ingredients."}]}],
"presets":[{"name":"Why you'll love it","blocks":[{"type":"benefit","settings":{"icon":"leaf","title":"Premium ingredients","text":"Carefully selected ingredients."}},{"type":"benefit","settings":{"icon":"flame","title":"Authentic taste","text":"Created for traditional Indian cooking."}},{"type":"benefit","settings":{"icon":"shield","title":"Quality processing","text":"Processed under controlled conditions."}},{"type":"benefit","settings":{"icon":"box","title":"Freshness","text":"Packaging designed to preserve aroma."}}]}]}
{% endschema %}
