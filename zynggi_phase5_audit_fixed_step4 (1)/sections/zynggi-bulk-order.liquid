    guidedInputs.forEach(function (el) {
      if (mode === 'quick') {
        el.dataset.prevDisabled = el.disabled ? '1' : '0';
        el.disabled = true;
      } else {
        // restore: chips checked => enable, product cards handled by change listener
        if (el.classList.contains('zynggi-prod-check')) {
          el.disabled = false;
        } else if (el.closest('[data-zynggi-prod-card]')) {
          // product card fields stay as they were (controlled by checkbox)
        } else {
          el.disabled = false;
        }
      }
    });
    // Re-apply product card state
    if (mode === 'guided') {
      root.querySelectorAll('.zynggi-prod-check').forEach(function (cb) {
        cb.dispatchEvent(new Event('change', { bubbles: false }));
      });
    }
  }
  modeButtons.forEach(function (b) {
    b.addEventListener('click', function () { setMode(b.getAttribute('data-zynggi-mode')); });
  });

  /* ---------- 3. Product chip → reveal card ---------- */
  var itemsContainer = root.querySelector('[data-zynggi-items]');
  var emptyMsg = root.querySelector('[data-zynggi-empty]');
  var countEls = root.querySelectorAll('[data-zynggi-count]');

  function refreshSummary() {
    if (!itemsContainer) return;
    var selected = [];
    root.querySelectorAll('.zynggi-prod-check:checked').forEach(function (cb) {
      var card = document.getElementById(cb.getAttribute('data-zynggi-target'));
      var qty = '', unit = '';
      if (card) {
        var q = card.querySelector('input[type="number"]');
        var u = card.querySelector('select:not([name*="Form"])');
        if (q && q.value) qty = q.value;
        if (u && u.value) unit = u.value;
      }
      selected.push({ name: cb.getAttribute('data-product-name'), qty: qty, unit: unit });
    });

    // update count
    countEls.forEach(function (el) { el.textContent = selected.length; });

    // items list
    itemsContainer.innerHTML = '';
    selected.forEach(function (s) {
      var row = document.createElement('div');
      row.className = 'zynggi-item';
      var meta = s.qty ? (s.qty + ' ' + (s.unit || '')) : '—';
      row.innerHTML = '<strong></strong><span class="zynggi-item-meta"></span>';
      row.querySelector('strong').textContent = s.name;
      row.querySelector('.zynggi-item-meta').textContent = meta;
      itemsContainer.appendChild(row);
    });

    if (emptyMsg) emptyMsg.hidden = selected.length > 0;

    // category badge counts
    root.querySelectorAll('.zynggi-cat').forEach(function (cat) {
      var n = cat.querySelectorAll('.zynggi-prod-check:checked').length;
      var badge = cat.querySelector('[data-cat-count]');
      if (badge) {
        badge.textContent = n;
        badge.hidden = n === 0;
      }
    });
  }

  root.querySelectorAll('.zynggi-prod-check').forEach(function (cb) {
    cb.addEventListener('change', function () {
      var card = document.getElementById(cb.getAttribute('data-zynggi-target'));
      if (!card) return;
      var fields = card.querySelectorAll('select, input[type="number"], input[type="hidden"]');
      if (cb.checked) {
        card.hidden = false;
        fields.forEach(function (f) {
          f.disabled = false;
          if (f.type === 'hidden') f.value = 'Yes';
        });
      } else {
        card.hidden = true;
        fields.forEach(function (f) {
          f.disabled = true;
          if (f.type === 'hidden') f.value = 'No';
          else if (f.tagName === 'SELECT') f.selectedIndex = 0;
          else f.value = '';
        });
      }
      refreshSummary();
    });
  });

  /* summary refresh when qty/unit change */
  root.querySelectorAll('[data-zynggi-prod-card] input[type="number"], [data-zynggi-prod-card] select').forEach(function (el) {
    el.addEventListener('input', refreshSummary);
    el.addEventListener('change', refreshSummary);
  });

  /* ---------- 4. Search ---------- */
  var searchInput = root.querySelector('[data-zynggi-search]');
  if (searchInput) {
    searchInput.addEventListener('input', function () {
      var q = searchInput.value.trim().toLowerCase();
      root.querySelectorAll('.zynggi-cat').forEach(function (cat) {
        var catTitle = (cat.getAttribute('data-cat-title') || '').toLowerCase();
        var anyVisible = false;
        cat.querySelectorAll('[data-zynggi-chip]').forEach(function (chip) {
          var term = (chip.getAttribute('data-search-term') || '').toLowerCase();
          var show = !q || term.indexOf(q) !== -1 || catTitle.indexOf(q) !== -1;
          chip.style.display = show ? '' : 'none';
          if (show) anyVisible = true;
        });
        cat.style.display = (anyVisible || !q) ? '' : 'none';
        // auto expand on active search
        if (q && anyVisible) {
          var head = cat.querySelector('[data-zynggi-acc]');
          var body = document.getElementById(head.getAttribute('aria-controls'));
          head.setAttribute('aria-expanded', 'true');
          if (body) body.hidden = false;
        }
      });
    });
  }

  /* ---------- 5. Scroll-to-form helper ---------- */
  root.querySelectorAll('[data-zynggi-scroll]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var preset = a.getAttribute('data-zynggi-preset');
      if (preset) {
        // switch to quick mode & prefill
        setMode('quick');
        var ta = root.querySelector('[data-zynggi-panel="quick"] textarea');
        if (ta) ta.value = preset;
      }
    });
  });

  /* ---------- 6. Mobile sticky bar visibility ---------- */
  var bar = root.querySelector('[data-zynggi-bar]');
  var formEl = document.getElementById(formId);
  if (bar && formEl && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        bar.classList.toggle('is-visible', !entry.isIntersecting);
      });
    }, { rootMargin: '-60px 0px 0px 0px' });
    io.observe(formEl);
  }

  /* ---------- 7. Initial state ---------- */
  refreshSummary();
})();
</script>

