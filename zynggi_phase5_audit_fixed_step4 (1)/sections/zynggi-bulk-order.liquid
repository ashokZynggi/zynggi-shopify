<section id="ZynggiBulkOrder-{{ section.id }}" class="zynggi-bulk-order">
  <div class="zynggi-container">

    {%- comment -%} ============ CATALOGUE DATA ============ {%- endcomment -%}
    {%- assign cat_keys    = 'whole|powder|herb|blend' | split: '|' -%}
    {%- assign cat_titles  = 'Whole / Raw Spices & Seeds|Ground & Powdered Spices|Herbs, Leaves & Dried Botanicals|Blended Masalas & Seasonings' | split: '|' -%}
    {%- assign cat_help    = 'Whole, raw and unground spices and seeds.|Ready ground and powdered spices.|Dried herbs, leaves, flakes and botanicals.|Indian masalas and international seasonings.' | split: '|' -%}
    {%- assign cat_prefix  = 'Whole / Raw Spice|Ground / Powder|Herb / Leaf|Blended Masala' | split: '|' -%}
    {%- assign cat_forms   = 'Whole / Raw~Crushed / Coarse~To Be Ground by Zynggi|Fine Powder~Medium Grind~Coarse Grind|Whole / Dried~Flakes~Powder|Ready Blend~Custom Blend~Recipe / Formula Based' | split: '|' -%}

    {%- assign whole_products  = 'Turmeric / Haldi|Coriander / Dhaniya|Cumin / Jeera|Black Cumin / Kala Jeera|Fennel / Saunf|Fenugreek / Methi|Ajwain|Kalonji|Mustard / Rai|Black Pepper / Kali Mirch|White Pepper|Pippali|Green Cardamom / Chhoti Elaichi|Black Cardamom / Badi Elaichi|Clove / Laung|Cinnamon / Dalchini|Cassia|Nutmeg / Jaiphal|Mace / Javitri|Star Anise|Bay Leaf / Tej Patta|Dagad Phool|Saffron / Kesar|Dry Red Chilli|Kashmiri Red Chilli|Degi Red Chilli|Paprika|Dry Ginger / Sonth|Galangal|Mulethi|Hing|Celery Seed|Dill Seed / Suva|Poppy Seed / Khus Khus|Sesame / Til|Flax / Alsi|Anardana|Kabab Chini|Juniper Berry' | split: '|' -%}
    {%- assign powder_products = 'Turmeric Powder / Haldi|Coriander Powder / Dhaniya|Cumin Powder / Jeera|Black Pepper Powder|White Pepper Powder|Red Chilli Powder|Kashmiri Chilli Powder|Degi Chilli Powder|Paprika Powder|Fennel Powder / Saunf|Fenugreek Powder / Methi|Dry Ginger Powder / Sonth|Cardamom Powder|Cinnamon Powder|Clove Powder|Nutmeg Powder / Jaiphal|Mace Powder / Javitri|Amchur Powder|Tamarind Powder|Garlic Powder|Onion Powder|Tomato Powder|Curry Leaf Powder|Mint Powder / Pudina|Coriander Leaf Powder|Kasuri Methi Powder|Lemon Powder|Moringa Powder|Coconut Powder|Black Salt / Kala Namak|Rock Salt / Sendha Namak|Normal Salt|Chaat Salt|Hing Compound' | split: '|' -%}
    {%- assign herb_products   = 'Kasuri Methi / Dried Fenugreek Leaves|Dried Mint / Pudina|Dried Coriander Leaves|Dried Curry Leaves|Dried Basil|Dried Oregano|Dried Thyme|Dried Rosemary|Dried Sage|Dried Parsley|Dried Tarragon|Dried Dill|Dried Marjoram|Dry Lemongrass|Moringa Leaves|Dried Garlic Flakes|Dried Onion Flakes|Dried Chilli Flakes' | split: '|' -%}
    {%- assign blend_products  = 'Garam Masala|Chana Masala|Chhole Masala|Chicken Masala|Meat Masala|Mutton Masala|Fish Masala|Biryani Masala|Pulao Masala|Tandoori Masala|Tikka Masala|Butter Chicken Masala|Korma Masala|Curry Masala|Curry Powder|Kitchen King Masala|Paneer Masala|Shahi Paneer Masala|Kadai Masala|Sabzi Masala|Mixed Vegetable Masala|Dal Masala|Dal Tadka Masala|Rajma Masala|Pav Bhaji Masala|Chaat Masala|Jaljeera Masala|Sambhar Masala|Rasam Powder|Idli / Dosa Masala|Achari Masala|Keema Masala|Seekh Kebab Masala|Shawarma Masala|Grill Masala|Barbecue Masala|Peri Peri Masala|Chilli Garlic Seasoning|Italian Seasoning|Pizza Seasoning|Pasta Seasoning|Chinese Five Spice|Cajun Seasoning|Taco Seasoning|Fajita Seasoning|Steak Seasoning|Lemon Pepper Seasoning|Custom Spice Blend' | split: '|' -%}
    {%- assign all_products    = whole_products | concat: powder_products | concat: herb_products | concat: blend_products -%}

    {%- assign form_id = 'ZynggiBulkOrderForm-' | append: section.id -%}

    {%- comment -%} ============ HERO ============ {%- endcomment -%}
    <header class="zynggi-hero">
      <span class="zynggi-eyebrow">ZYNGGI B2B</span>
      <h1>Bulk Spices &amp; Custom Blends for Your Business</h1>
      <p>Source whole spices, powders, blends and custom seasonings directly from Zynggi. Tell us what you need — our team handles the rest.</p>

      <ul class="zynggi-benefits">
        <li>Bulk Supply</li>
        <li>Custom Grinding</li>
        <li>Custom Blending</li>
        <li>Business Packaging</li>
      </ul>

      <div class="zynggi-hero-cta">
        <a href="#zynggi-form-{{ section.id }}" class="zynggi-btn zynggi-btn--primary" data-zynggi-scroll>Request Bulk Quote</a>
        {%- if section.settings.whatsapp_number != blank -%}
          <a class="zynggi-btn zynggi-btn--ghost"
             href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | default: 'Hi Zynggi, I would like a bulk spice quote.' | url_encode }}"
             target="_blank" rel="noopener">Talk to Zynggi</a>
        {%- endif -%}
      </div>
    </header>

    <div id="zynggi-form-{{ section.id }}"></div>

    {%- comment -%} ============ FORM ============ {%- endcomment -%}
    {% form 'contact', id: form_id, class: 'zynggi-form' %}

      {%- if form.posted_successfully? -%}
        <div class="zynggi-notice zynggi-notice--success" role="status">
          <strong>Thank you — your enquiry has been sent.</strong>
          <p>Our team will review your requirement and contact you with pricing and availability.</p>
        </div>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="zynggi-notice zynggi-notice--error" role="alert">
          <strong>Please check your details and try again.</strong>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="zynggi-layout">
        <div class="zynggi-main">

          {%- comment -%} ---- STEP 1: WHAT DO YOU NEED ---- {%- endcomment -%}
          <div class="zynggi-card">
            <div class="zynggi-card-head">
              <span aria-hidden="true">01</span>
              <div>
                <h2>What do you need?</h2>
                <p>Pick products from the list, or just tell us in your own words.</p>
              </div>
            </div>

            <div class="zynggi-modes" role="tablist" aria-label="Enquiry mode">
              <button type="button" role="tab" id="zynggi-tab-guided-{{ section.id }}" class="zynggi-mode" aria-selected="true" aria-controls="zynggi-panel-guided-{{ section.id }}" data-zynggi-mode="guided">Choose products</button>
              <button type="button" role="tab" id="zynggi-tab-quick-{{ section.id }}" class="zynggi-mode" aria-selected="false" aria-controls="zynggi-panel-quick-{{ section.id }}" data-zynggi-mode="quick">Quick enquiry</button>
            </div>

            {%- comment -%} ===== GUIDED PANEL ===== {%- endcomment -%}
            <div class="zynggi-panel" id="zynggi-panel-guided-{{ section.id }}" role="tabpanel" aria-labelledby="zynggi-tab-guided-{{ section.id }}" data-zynggi-panel="guided">

              <div class="zynggi-search">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
                  <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
                </svg>
                <input type="search" class="zynggi-search-input" placeholder="Search spices, powders, blends…" aria-label="Search products" data-zynggi-search autocomplete="off">
              </div>

              <p class="zynggi-hint">Tap a category to see products. Tick what you need — quantity fields appear automatically.</p>

              {%- for key in cat_keys -%}
                {%- assign i = forloop.index0 -%}
                {%- assign cat_title   = cat_titles[i] -%}
                {%- assign cat_help_t  = cat_help[i] -%}
                {%- assign cat_pref    = cat_prefix[i] -%}
                {%- assign form_list   = cat_forms[i] | split: '~' -%}
                {%- case key -%}
                  {%- when 'whole'  -%}{%- assign items = whole_products  -%}
                  {%- when 'powder' -%}{%- assign items = powder_products -%}
                  {%- when 'herb'   -%}{%- assign items = herb_products   -%}
                  {%- when 'blend'  -%}{%- assign items = blend_products  -%}
                {%- endcase -%}
                {%- assign panel_id = 'zynggi-cat-' | append: section.id | append: '-' | append: key -%}

                <div class="zynggi-cat" data-cat-key="{{ key }}" data-cat-title="{{ cat_title | escape }}">
                  <button type="button" class="zynggi-cat-head" aria-expanded="false" aria-controls="{{ panel_id }}" data-zynggi-acc>
                    <span class="zynggi-cat-num" aria-hidden="true">0{{ i | plus: 1 }}</span>
                    <span class="zynggi-cat-text">
                      <strong>{{ cat_title }}</strong>
                      <small>{{ cat_help_t }}</small>
                    </span>
                    <span class="zynggi-cat-badge" data-cat-count hidden>0</span>
                    <span class="zynggi-cat-icon" aria-hidden="true"></span>
                  </button>

                  <div class="zynggi-cat-body" id="{{ panel_id }}" hidden>
                    <div class="zynggi-chips">
                      {%- for item in items -%}
                        {%- assign unique_id = key | append: '-' | append: forloop.index -%}
                        <label class="zynggi-chip" data-zynggi-chip data-search-term="{{ item | escape }}">
                          <input type="checkbox" class="zynggi-prod-check" data-zynggi-target="zynggi-prod-{{ section.id }}-{{ unique_id }}" data-product-name="{{ item | escape }}" data-cat-title="{{ cat_title | escape }}">
                          <span>{{ item }}</span>
                        </label>
                      {%- endfor -%}
                    </div>

                    {%- comment -%} Product detail cards revealed per selection {%- endcomment -%}
                    <div class="zynggi-prod-cards">
                      {%- for item in items -%}
                        {%- assign unique_id = key | append: '-' | append: forloop.index -%}
                        {%- assign field_base = cat_pref | append: ' - ' | append: item -%}
                        <div class="zynggi-prod-card" id="zynggi-prod-{{ section.id }}-{{ unique_id }}" data-zynggi-prod-card data-product-name="{{ item | escape }}" hidden>
                          <div class="zynggi-prod-card-head">
                            <strong>{{ item }}</strong>
                            <span class="zynggi-prod-card-cat">{{ cat_title }}</span>
                          </div>
                          <div class="zynggi-prod-card-grid">
                            <div class="zynggi-field">
                              <label for="form-{{ section.id }}-{{ unique_id }}">Form</label>
                              <select id="form-{{ section.id }}-{{ unique_id }}" name="contact[{{ field_base }} - Form]" disabled>
                                <option value="">Select form</option>
                                {%- for f in form_list -%}<option value="{{ f }}">{{ f }}</option>{%- endfor -%}
                              </select>
                            </div>
                            <div class="zynggi-field">
                              <label for="qty-{{ section.id }}-{{ unique_id }}">Quantity</label>
                              <input id="qty-{{ section.id }}-{{ unique_id }}" type="number" min="0" step="0.01" inputmode="decimal" name="contact[{{ field_base }} - Quantity]" placeholder="e.g. 100" disabled>
                            </div>
                            <div class="zynggi-field">
                              <label for="unit-{{ section.id }}-{{ unique_id }}">Unit</label>
                              <select id="unit-{{ section.id }}-{{ unique_id }}" name="contact[{{ field_base }} - Unit]" disabled>
                                <option value="kg">kg</option>
                                <option value="g">g</option>
                                <option value="ton">Ton</option>
                              </select>
                            </div>
                          </div>
                          <input type="hidden" name="contact[{{ field_base }} - Selected]" value="No" data-zynggi-selected disabled>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}

              {%- comment -%} ---- OTHER INGREDIENT ---- {%- endcomment -%}
              <div class="zynggi-other">
                <h3>Can't find it?</h3>
                <p class="zynggi-hint">Add any other spice, herb or ingredient — we probably stock it.</p>
                <div class="zynggi-other-grid">
                  <input type="text" name="contact[Other Ingredient Name]" placeholder="Ingredient name" aria-label="Other ingredient name">
                  <input type="number" min="0" step="0.01" inputmode="decimal" name="contact[Other Ingredient Quantity]" placeholder="Quantity" aria-label="Other ingredient quantity">
                  <select name="contact[Other Ingredient Unit]" aria-label="Other ingredient unit">
                    <option value="kg">kg</option><option value="g">g</option><option value="ton">Ton</option>
                  </select>
                  <select name="contact[Other Ingredient Form]" aria-label="Other ingredient form">
                    <option value="">Form</option>
                    <option>Whole / Raw</option><option>Crushed / Coarse</option><option>Fine Powder</option>
                    <option>Flakes</option><option>Leaves</option><option>Blend</option><option>Other</option>
                  </select>
                </div>
              </div>
            </div>

            {%- comment -%} ===== QUICK PANEL ===== {%- endcomment -%}
            <div class="zynggi-panel" id="zynggi-panel-quick-{{ section.id }}" role="tabpanel" aria-labelledby="zynggi-tab-quick-{{ section.id }}" data-zynggi-panel="quick" hidden>
              <div class="zynggi-field">
                <label for="zynggi-quick-{{ section.id }}">Tell us what you need</label>
                <textarea id="zynggi-quick-{{ section.id }}" name="contact[body]" rows="5" placeholder="Example: I run a restaurant in Pune. I need around 100 kg turmeric powder and 50 kg red chilli powder every month."></textarea>
                <p class="zynggi-hint">Write it however you like — Hindi or English. We'll work out the details with you.</p>
              </div>
            </div>
          </div>

          {%- comment -%} ---- STEP 2: QUANTITY ---- {%- endcomment -%}
          <div class="zynggi-card">
            <div class="zynggi-card-head">
              <span aria-hidden="true">02</span>
              <div>
                <h2>Roughly how much?</h2>
                <p>An estimate is fine — we'll confirm exact quantities later.</p>
              </div>
            </div>

            <fieldset class="zynggi-fieldset">
              <legend class="zynggi-legend">Approximate requirement</legend>
              <div class="zynggi-ranges">
                <label class="zynggi-range"><input type="radio" name="contact[Approximate Quantity]" value="Less than 50 kg"><span>Under 50 kg</span></label>
                <label class="zynggi-range"><input type="radio" name="contact[Approximate Quantity]" value="50-100 kg"><span>50–100 kg</span></label>
                <label class="zynggi-range"><input type="radio" name="contact[Approximate Quantity]" value="100-500 kg"><span>100–500 kg</span></label>
                <label class="zynggi-range"><input type="radio" name="contact[Approximate Quantity]" value="500 kg - 1 Ton"><span>500 kg – 1 Ton</span></label>
                <label class="zynggi-range"><input type="radio" name="contact[Approximate Quantity]" value="1 Ton+"><span>1 Ton +</span></label>
                <label class="zynggi-range"><input type="radio" name="contact[Approximate Quantity]" value="Not sure yet"><span>Not sure yet</span></label>
              </div>
            </fieldset>

            <div class="zynggi-field zynggi-field--spaced">
              <label for="zynggi-exact-{{ section.id }}">Or enter an exact quantity <span class="zynggi-optional">(optional)</span></label>
              <input id="zynggi-exact-{{ section.id }}" type="text" name="contact[Exact Quantity]" placeholder="Example: 250 kg per month">
            </div>
          </div>

          {%- comment -%} ---- STEP 3: DETAILS ---- {%- endcomment -%}
          <div class="zynggi-card">
            <div class="zynggi-card-head">
              <span aria-hidden="true">03</span>
              <div>
                <h2>Your details</h2>
                <p>Just enough for us to get back to you.</p>
              </div>
            </div>

            <div class="zynggi-grid zynggi-grid--2">
              <div class="zynggi-field">
                <label for="zynggi-name-{{ section.id }}">Full name *</label>
                <input id="zynggi-name-{{ section.id }}" type="text" name="contact[Full Name]" placeholder="Your name" autocomplete="name" required>
              </div>
              <div class="zynggi-field">
                <label for="zynggi-phone-{{ section.id }}">Phone number *</label>
                <input id="zynggi-phone-{{ section.id }}" type="tel" name="contact[Phone]" placeholder="+91 98765 43210" autocomplete="tel" inputmode="tel" required>
              </div>
              <div class="zynggi-field">
                <label for="zynggi-business-{{ section.id }}">Business name <span class="zynggi-optional">(optional)</span></label>
                <input id="zynggi-business-{{ section.id }}" type="text" name="contact[Business Name]" placeholder="Your business name" autocomplete="organization">
              </div>
              <div class="zynggi-field">
                <label for="zynggi-type-{{ section.id }}">Business type</label>
                <select id="zynggi-type-{{ section.id }}" name="contact[Business Type]">
                  <option value="">Select business type</option>
                  <option value="Retailer">Retailer / Shop</option>
                  <option value="Restaurant / Hotel">Restaurant / Hotel</option>
                  <option value="Cloud Kitchen">Cloud Kitchen</option>
                  <option value="Distributor">Distributor</option>
                  <option value="Manufacturer">Manufacturer</option>
                  <option value="Food Brand">Food Brand</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="zynggi-field">
                <label for="zynggi-city-{{ section.id }}">City <span class="zynggi-optional">(optional)</span></label>
                <input id="zynggi-city-{{ section.id }}" type="text" name="contact[City]" placeholder="Your city" autocomplete="address-level2">
              </div>
              <div class="zynggi-field">
                <label for="zynggi-email-{{ section.id }}">Email <span class="zynggi-optional">(optional)</span></label>
                <input id="zynggi-email-{{ section.id }}" type="email" name="contact[email]" placeholder="you@example.com" autocomplete="email">
              </div>
            </div>
          </div>

          {%- comment -%} ---- STEP 4: ANYTHING ELSE ---- {%- endcomment -%}
          <div class="zynggi-card">
            <div class="zynggi-card-head">
              <span aria-hidden="true">04</span>
              <div>
                <h2>Anything else we should know?</h2>
                <p>Optional — quality, packaging, delivery location, timelines.</p>
              </div>
            </div>
            <div class="zynggi-field">
              <label class="zynggi-visually-hidden" for="zynggi-notes-{{ section.id }}">Additional requirements</label>
              <textarea id="zynggi-notes-{{ section.id }}" name="contact[Additional Requirements]" rows="3" placeholder="Tell us about packaging, quality, delivery location or anything else."></textarea>
            </div>
          </div>
        </div>

        {%- comment -%} ============ ASIDE ============ {%- endcomment -%}
        <aside class="zynggi-aside" aria-label="Your requirement summary">
          <div class="zynggi-aside-inner">
            <div class="zynggi-summary">
              <div class="zynggi-summary-head">
                <h2>Your requirement</h2>
                <span class="zynggi-summary-count"><b data-zynggi-count>0</b> items</span>
              </div>

              <p class="zynggi-empty" data-zynggi-empty>Nothing selected yet — that's fine. You can also just describe what you need and we'll help you choose.</p>

              <div class="zynggi-items" data-zynggi-items></div>

              <button type="submit" class="zynggi-submit">
                <span>Request My Bulk Quote</span>
                <span aria-hidden="true">→</span>
              </button>

              <p class="zynggi-trust">No payment required. Our team will contact you with availability and pricing.</p>

              {%- if section.settings.whatsapp_number != blank -%}
                <p class="zynggi-wa">
                  Prefer WhatsApp?
                  <a href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | default: 'Hi Zynggi, I would like a bulk spice quote.' | url_encode }}" target="_blank" rel="noopener">Chat with Zynggi →</a>
                </p>
              {%- endif -%}
            </div>
          </div>
        </aside>
      </div>

    {% endform %}

    {%- comment -%} ---------- WHAT HAPPENS NEXT ---------- {%- endcomment -%}
    <section class="zynggi-block" aria-labelledby="zynggi-steps-title-{{ section.id }}">
      <h2 class="zynggi-block-title" id="zynggi-steps-title-{{ section.id }}">What happens next?</h2>
      <div class="zynggi-steps">
        <div class="zynggi-step"><b>STEP 1</b><strong>You tell us what you need</strong><p>Submit your requirement in under a minute.</p></div>
        <div class="zynggi-step"><b>STEP 2</b><strong>We review it</strong><p>Our team checks availability and your specifications.</p></div>
        <div class="zynggi-step"><b>STEP 3</b><strong>You get a quote</strong><p>We contact you with pricing and options.</p></div>
        <div class="zynggi-step"><b>STEP 4</b><strong>You confirm the order</strong><p>Once everything is finalised, we process your order.</p></div>
      </div>
    </section>

    {%- comment -%} ---------- CUSTOM / PRIVATE LABEL ---------- {%- endcomment -%}
    <section class="zynggi-block" aria-labelledby="zynggi-custom-title-{{ section.id }}">
      <h2 class="zynggi-block-title" id="zynggi-custom-title-{{ section.id }}">Need something custom?</h2>
      <p class="zynggi-block-sub">These are handled separately by our formulation team.</p>

      <div class="zynggi-custom-grid">
        <div class="zynggi-custom-card"><strong>Custom Spice Blend</strong><p>A blend created to your recipe, taste profile or specification.</p></div>
        <div class="zynggi-custom-card"><strong>Private Label</strong><p>We manufacture and pack spices under your own brand.</p></div>
        <div class="zynggi-custom-card"><strong>Custom Packaging</strong><p>Business packaging, pack sizes and formats built around you.</p></div>
      </div>

      <div class="zynggi-custom-cta">
        <a href="#zynggi-form-{{ section.id }}" class="zynggi-btn zynggi-btn--primary" data-zynggi-scroll data-zynggi-preset="Custom blend / private label">Discuss Custom Requirement</a>
      </div>
    </section>
  </div>

  {%- comment -%} ---------- MOBILE STICKY BAR ---------- {%- endcomment -%}
  <div class="zynggi-mobilebar" data-zynggi-bar>
    <span class="zynggi-mobilebar-text">
      <b data-zynggi-count>0</b> items selected
      <span>No payment required</span>
    </span>
    <button type="submit" form="{{ form_id }}" class="zynggi-btn zynggi-btn--primary">Request Quote →</button>
  </div>
</section>

<style>
  #ZynggiBulkOrder-{{ section.id }} {
    --zynggi-brown: #2d1b14;
    --zynggi-gold: #c58a28;
    --zynggi-cream: #f6efe4;
    --zynggi-light: #fbf8f3;
    --zynggi-border: #e3d8ca;
    --zynggi-text: #3a2b24;
    --zynggi-muted: #75675e;
    --zynggi-radius: 18px;
    background: var(--zynggi-cream);
    color: var(--zynggi-text);
    padding: 40px 16px 90px;
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  #ZynggiBulkOrder-{{ section.id }} *, #ZynggiBulkOrder-{{ section.id }} *::before, #ZynggiBulkOrder-{{ section.id }} *::after { box-sizing: border-box; }
  #ZynggiBulkOrder-{{ section.id }} [hidden] { display: none !important; }
  #ZynggiBulkOrder-{{ section.id }} .zynggi-container { max-width: 1180px; margin: 0 auto; }
  #ZynggiBulkOrder-{{ section.id }} .zynggi-visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* Hero */
  #ZynggiBulkOrder-{{ section.id }} .zynggi-hero { max-width: 820px; margin: 0 auto 30px; text-align: center; }
  #ZynggiBulkOrder-{{ section.id }} .zynggi-eyebrow { display: inline-block; padding: 6px 14px; border: 1px solid var(--zynggi-border); border-radius: 999px; background: #fff; color: var(--zynggi-gold); font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; }
