<section class="section bg-{{ section.settings.bg }}"><div class="container" style="max-width:820px">
  <h2>{{ section.settings.heading }}</h2>
  <div class="tl">{%- for b in section.blocks -%}<div {{ b.shopify_attributes }}><b>{{ b.settings.label }}</b><h3 style="margin:4px 0">{{ b.settings.title }}</h3><p style="margin:0">{{ b.settings.text }}</p></div>{%- endfor -%}</div>
</div></section>
{% schema %}
{"name":"Timeline","settings":[{"type":"text","id":"heading","label":"Heading","default":"Our journey"},{"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"}],"default":"white"}],"blocks":[{"type":"item","name":"Milestone","settings":[{"type":"text","id":"label","label":"Year or step","default":"[YEAR]"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"text","label":"Text","info":"Real milestones only"}]}],"presets":[{"name":"Timeline"}]}
{% endschema %}
