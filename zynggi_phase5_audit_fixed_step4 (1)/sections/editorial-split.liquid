<section class="section bg-{{ section.settings.bg }}">
  <div class="container split{% if section.settings.image_right %} split--rev{% endif %}">
    <div class="split__media">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.heading }}{%- endif -%}</div>
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <div>{{ section.settings.text }}</div>
      {%- if section.settings.cta_text != blank -%}<a class="btn btn--primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Editorial image + text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"image_right","label":"Image on right","default":false},{"type":"text","id":"heading","label":"Heading","default":"Our story"},{"type":"richtext","id":"text","label":"Text","default":"<p>[BRAND ORIGIN STORY]</p>"},{"type":"text","id":"cta_text","label":"Button text"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"}],"default":"white"}],"presets":[{"name":"Editorial image + text"}]}
{% endschema %}
