      <div class="zynggi-admin-payment-stats">
        <div class="zynggi-admin-money-card"><span>Total Billed</span><strong id="adminTotalBilled">₹0.00</strong></div>
        <div class="zynggi-admin-money-card"><span>Total Received</span><strong id="adminTotalReceived">₹0.00</strong></div>
        <div class="zynggi-admin-money-card"><span>Total Pending</span><strong id="adminTotalPending">₹0.00</strong></div>
