      </div>
      <button type="button" id="adminLogout" class="zynggi-admin-button zynggi-admin-outline">Logout</button>
    </header>

    <div id="adminLoading" class="zynggi-admin-loading">Loading admin dashboard...</div>

    <div id="adminApp" style="display:none;">
      <div class="zynggi-admin-stats">
        <div class="zynggi-admin-stat"><span>Total Orders</span><strong id="adminTotalOrders">0</strong></div>
        <div class="zynggi-admin-stat"><span>Today's Orders</span><strong id="adminTodayOrders">0</strong></div>
        <div class="zynggi-admin-stat"><span>Pending Orders</span><strong id="adminPendingOrders">0</strong></div>
        <div class="zynggi-admin-stat"><span>Completed</span><strong id="adminCompletedOrders">0</strong></div>
        <div class="zynggi-admin-stat"><span>Total Shops</span><strong id="adminTotalShops">0</strong></div>
