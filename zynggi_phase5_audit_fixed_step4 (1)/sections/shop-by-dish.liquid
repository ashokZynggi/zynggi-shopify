<section class="section bg-{{ section.settings.bg }}">
  <div class="container">
    <div class="section__head"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div></div>
    <div class="scroller zynggi-dish-scroller" style="grid-auto-columns:minmax(120px,1fr);grid-auto-flow:column">
      {%- for block in section.blocks -%}
        <a class="dish" href="{{ block.settings.link | default: routes.search_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '140px', alt: block.settings.title }}{%- else -%}<div style="aspect-ratio:1;border-radius:50%;background:var(--c-warm);width:100%"></div>{%- endif -%}
          <span>{{ block.settings.title }}</span>
        </a>
      {%- endfor -%}
    </div>
    <div class="zynggi-dish-swipe-hint" aria-hidden="true">Swipe to explore dishes <span>→</span></div>
  </div>
</section>
{% schema %}
{"name":"Shop by dish","settings":[{"type":"text","id":"heading","label":"Heading","default":"Choose your dish"},{"type":"text","id":"subheading","label":"Subheading"},{"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"}],"default":"white"}],
"blocks":[{"type":"dish","name":"Dish","settings":[{"type":"text","id":"title","label":"Dish name","default":"Biryani"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link","info":"Collection, tag filter, or search URL"}]}],
"presets":[{"name":"Shop by dish","blocks":[{"type":"dish","settings":{"title":"Biryani"}},{"type":"dish","settings":{"title":"Chole"}},{"type":"dish","settings":{"title":"Paneer"}},{"type":"dish","settings":{"title":"Chicken"}},{"type":"dish","settings":{"title":"Dal"}},{"type":"dish","settings":{"title":"Chaat"}}]}]}
{% endschema %}

<style>
  .zynggi-dish-swipe-hint { display:none; }
  @media screen and (max-width:749px) {
    .zynggi-dish-scroller {
      grid-auto-columns: calc((100% - 20px) / 3.15) !important;
      gap: 10px !important;
      padding-bottom: 10px !important;
      scrollbar-width: thin !important;
      scroll-snap-type: x proximity !important;
    }
    .zynggi-dish-scroller::-webkit-scrollbar { display:block; height:4px; }
    .zynggi-dish-scroller::-webkit-scrollbar-track { background:rgba(0,0,0,.08); border-radius:99px; }
    .zynggi-dish-scroller::-webkit-scrollbar-thumb { background:rgba(80,45,25,.35); border-radius:99px; }
    .zynggi-dish-swipe-hint { display:flex; justify-content:center; align-items:center; gap:6px; margin-top:6px; font-size:.72rem; color:rgba(42,26,18,.62); }
    .zynggi-dish-swipe-hint span { font-size:1rem; }
  }
</style>
