    document

      .getElementById(

        "getLocationButton"

      )

      .addEventListener(

        "click",

        function () {



          const status =

            document.getElementById(

              "locationStatus"

            );



          if (!navigator.geolocation) {

            status.textContent =

              "Location is not supported.";

            return;

          }



          status.textContent =

            "Getting location...";



          navigator.geolocation.getCurrentPosition(

            function (position) {



              document.getElementById(

                "shopLatitude"

              ).value =

                position.coords.latitude;



              document.getElementById(

                "shopLongitude"

              ).value =

                position.coords.longitude;



              status.textContent =

                "Location captured successfully.";



            },

            function () {



              status.textContent =

                "Unable to get location. Please allow location access.";



            }

          );



        }

      );



    document

      .getElementById(

        "shopForm"

      )

      .addEventListener(

        "submit",

        async function (event) {



          event.preventDefault();



          const button =

            document.getElementById(

              "saveShopButton"

            );



          const message =

            document.getElementById(

              "shopMessage"

            );



          button.disabled = true;

          button.textContent =

            "Saving...";



          message.textContent = "";



          try {



            let photoData = null;



            const photoInput =

              document.getElementById(

                "shopPhoto"

              );



            if (

              photoInput.files &&

              photoInput.files[0]

            ) {



              photoData =

                await new Promise(

                  function (resolve, reject) {



                    const reader =

                      new FileReader();



                    reader.onload =

                      function () {

                        resolve(

                          reader.result

                        );

                      };



                    reader.onerror =

                      reject;



                    reader.readAsDataURL(

                      photoInput.files[0]

                    );



                  }

                );



            }



            const shopData = {

              salesman_id:

                currentUser.id,



              shop_name:

                document.getElementById(

                  "shopName"

                ).value.trim(),



              owner_name:

                document.getElementById(

                  "ownerName"

                ).value.trim(),



              mobile:

                document.getElementById(

                  "shopMobile"

                ).value.trim(),



              address:

                document.getElementById(

                  "shopAddress"

                ).value.trim(),



              pincode:

                document.getElementById(

                  "shopPincode"

                ).value.trim(),



              city:

                document.getElementById(

                  "shopCity"

                ).value.trim(),



              latitude:

                Number(

                  document.getElementById(

                    "shopLatitude"

                  ).value

                ) || null,



              longitude:

                Number(

                  document.getElementById(

                    "shopLongitude"

                  ).value

                ) || null,



              shop_photo:

                photoData

            };



            const response =

              await supabaseFetch(

                "/rest/v1/shops",

                {

                  method: "POST",

                  headers: {

                    "Prefer":

                      "return=representation"

                  },

                  body:

                    JSON.stringify(

                      shopData

                    )

                }

              );



            const data =

              await response.json();



            if (!response.ok) {

              throw new Error(

                data.message ||

                "Unable to save shop."

              );

            }



            message.style.color =

              "#287a3e";



            message.textContent =

              "Shop saved successfully.";



            document

              .getElementById(

                "shopForm"

              )

              .reset();



            document.getElementById(

              "locationStatus"

            ).textContent =

              "Location not captured";



            await loadShops();



          } catch (error) {



            console.error(

              "Shop Error:",

              error

            );



            message.style.color =

              "#b42318";



            message.textContent =

              error.message ||

              "Unable to save shop.";



          }



          button.disabled = false;

          button.textContent =

            "Save Shop";



        }

      );



    document

      .getElementById(

        "submitOrderButton"

      )

      .addEventListener(

        "click",

        async function () {



          const shopId =

            document.getElementById(

              "orderShop"

            ).value;



          const selectedProducts =

            getSelectedProducts();



          const notes =

            document.getElementById(

              "orderNotes"

            ).value.trim();



          const message =

            document.getElementById(

              "orderMessage"

            );



          const button =

            document.getElementById(

              "submitOrderButton"

            );



          message.textContent = "";



          if (!shopId) {

            message.style.color =

              "#b42318";



            message.textContent =

              "Please select a shop.";



            return;

          }



          if (!selectedProducts.length) {

            message.style.color =

              "#b42318";



            message.textContent =

              "Please select at least one product.";



            return;

          }



          button.disabled = true;

          button.textContent =

            "Submitting...";



          try {



            const totalItems =

              selectedProducts.reduce(

                function (

                  total,

                  item

                ) {

                  return (

                    total +

                    item.quantity

                  );

                },

                0

              );



            const orderResponse =

              await supabaseFetch(

                "/rest/v1/orders",

                {

                  method: "POST",

                  headers: {

                    "Prefer":

                      "return=representation"

                  },

                  body:

                    JSON.stringify({

                      salesman_id:

                        currentUser.id,



                      shop_id:

                        Number(shopId),



                      status:

                        "pending",



                      total_items:

                        totalItems,



                      notes:

                        notes

                    })

                }

              );



            const orderData =

              await orderResponse.json();



            if (!orderResponse.ok) {

              throw new Error(

                orderData.message ||

                "Unable to create order."

              );

            }



            const order =

              Array.isArray(

                orderData

              )

                ? orderData[0]

                : orderData;



            const orderItems =

              selectedProducts.map(

                function (item) {



                  return {

                    order_id:

                      order.id,



                    product_id:

                      String(

                        item.productId

                      ),



                    product_name:

                      item.productName,



                    quantity:

                      item.quantity,



                    price:

                      item.price

                  };



                }

              );



            const itemsResponse =

              await supabaseFetch(

                "/rest/v1/order_items",

                {

                  method: "POST",

                  body:

                    JSON.stringify(

                      orderItems

                    )

                }

              );



            if (!itemsResponse.ok) {



              const itemError =

                await itemsResponse.json();



              throw new Error(

                itemError.message ||

                "Order created but items could not be saved."

              );

            }



            message.style.color =

              "#287a3e";



            message.textContent =

              "Order submitted successfully.";



            document.getElementById(

              "orderNotes"

            ).value = "";



            document.getElementById(

              "orderShop"

            ).value = "";



            document

              .querySelectorAll(

                ".product-quantity"

              )

              .forEach(

                function (input) {

                  input.value = 0;

                }

              );



            
            document
              .querySelectorAll(".product-discount")
              .forEach(function (input) {
                input.value = 0;
              });

            updateProductFinalRates();

            updateOrderSummary();



            await loadOrders();



          } catch (error) {



            console.error(

              "Order Error:",

              error

            );



            message.style.color =

              "#b42318";



            message.textContent =

              error.message ||

              "Unable to submit order.";



          }



          button.disabled = false;

          button.textContent =

            "Confirm Order";



        }

      );



    document

      .getElementById(

        "salesmanLogout"

      )

      .addEventListener(

        "click",

        function () {



          localStorage.removeItem(

            "zynggi_salesman"

          );



          localStorage.removeItem(

            "zynggi_salesman_user_id"

          );



          sessionStorage.removeItem(

            "zynggi_salesman_access_token"

          );

          localStorage.removeItem(

            "zynggi_salesman_access_token"

          );



          localStorage.removeItem(

            "zynggi_salesman_refresh_token"

          );



          window.location.href =

            "/pages/zynggi-business-portal";



        }

      );



    document

      .querySelectorAll(

        ".zynggi-action-card"

      )

      .forEach(

        function (button) {



          button.addEventListener(

            "click",

            function () {



              const targetId =

                button.dataset.target;



              const target =

                document.getElementById(

                  targetId

                );



              if (target) {



                target.scrollIntoView({

                  behavior: "smooth",

                  block: "start"

                });



              }



            }

          );



        }

      );



    document

      .getElementById(

        "refreshShops"

      )

      .addEventListener(

        "click",

        loadShops

      );



    document

      .getElementById(

        "refreshOrders"

      )

      .addEventListener(

        "click",

        loadOrders

      );



    document.addEventListener(

      "input",

      function (event) {
        if (
          event.target.classList.contains("product-quantity") ||
          event.target.classList.contains("product-discount")
        ) {

          if (
            event.target.classList.contains("product-discount")
          ) {
            let value = Number(event.target.value || 0);

            if (!Number.isFinite(value)) {
              value = 0;
            }

            value = Math.max(0, Math.min(15, value));
            event.target.value = value;
          }

          updateProductFinalRates();
          updateOrderSummary();
        }



      }

    );



    try {



      const authenticated =

        await checkAuthentication();



      if (!authenticated) {

        return;

      }



      await loadSalesman();

      await loadShops();

      await loadProducts();

      await loadOrders();



      loading.style.display =

        "none";



      dashboard.style.display =

        "block";



    } catch (error) {



      console.error(

        "Dashboard Error:",

        error

      );



      loading.innerHTML = `

        <div class="zynggi-list-card">

          <strong>

            Unable to load dashboard

          </strong>



          <p>

            ${escapeHtml(

              error.message ||

              "Something went wrong."

            )}

          </p>

        </div>

      `;



    }



  });

</script>



