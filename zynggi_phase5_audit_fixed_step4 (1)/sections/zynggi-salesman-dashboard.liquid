    const accessToken =

      sessionStorage.getItem(

        "zynggi_salesman_access_token"

      ) || localStorage.getItem(

        "zynggi_salesman_access_token"

      );



    // Legacy token migration: move an old localStorage token into sessionStorage once.
    if (accessToken) {
      try {
        sessionStorage.setItem("zynggi_salesman_access_token", accessToken);
        localStorage.removeItem("zynggi_salesman_access_token");
      } catch (error) {
        console.warn("Unable to migrate Zynggi session token.", error);
      }
    }

    let sessionExpiryTimer = null;

