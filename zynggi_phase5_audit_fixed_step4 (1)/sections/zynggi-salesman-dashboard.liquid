-")}</p><p>${escapeHtml(shop ? shop.address : "")}, ${escapeHtml(shop ? shop.city : "")} - ${escapeHtml(shop ? shop.pincode : "")}</p></div><div class="box"><b>Salesman</b><p>${escapeHtml(currentSalesman.name || "-")}</p><p>Code: ${escapeHtml(currentSalesman.salesman_code || "-")}</p><p>Mobile: ${escapeHtml(currentSalesman.mobile || "-")}</p></div></div><div class="box"><table><thead><tr><th>Product</th><th>Qty</th><th>Rate</th><th>Taxable Amount</th></tr></thead><tbody>${rows}</tbody></table><div class="summary"><div class="row"><span>Taxable Value</span><b>${formatMoney(subtotal)}</b></div><div class="row"><span>CGST 2.5%</span><b>${formatMoney(gst/2)}</b></div><div class="row"><span>SGST 2.5%</span><b>${formatMoney(gst/2)}</b></div><div class="row grand"><span>Grand Total</span><b>${formatMoney(grand)}</b></div></div><div class="paid">Payment Received: ${formatMoney(paid)} &nbsp; | &nbsp; Balance Pending: ${formatMoney(due)} &nbsp; | &nbsp; Status: ${escapeHtml(paymentStatus(order.id))}</div></div><div class="box"><h3>Payment History</h3><table><thead><tr><th>Date</th><th>Amount</th><th>Mode</th><th>Reference</th></tr></thead><tbody>${paymentRows}</tbody></table></div><p>Thank you for your business.</p><button class="no-print" onclick="window.print()">Print Bill</button></body></html>`);
