    async function saveSalesmanPayment(orderId) {
      const amountInput = document.getElementById("salesmanPaymentAmount");
      const dateInput = document.getElementById("salesmanPaymentDate");
      const modeInput = document.getElementById("salesmanPaymentMode");
      const referenceInput = document.getElementById("salesmanPaymentReference");
      const notesInput = document.getElementById("salesmanPaymentNotes");
      const message = document.getElementById("salesmanPaymentMessage");
      const button = document.getElementById("saveSalesmanPayment");

      const amount = Number(amountInput.value || 0);
      const due = pendingTotal(orderId);

      message.textContent = "";

      if (!dateInput.value) {
        message.style.color = "#b42318";
        message.textContent = "Please select payment date.";
        return;
      }

      if (!Number.isFinite(amount) || amount <= 0) {
        message.style.color = "#b42318";
        message.textContent = "Please enter a valid payment amount.";
        return;
      }

      if (amount > due + 0.009) {
        message.style.color = "#b42318";
        message.textContent = "Payment cannot be greater than pending amount.";
        return;
      }

      button.disabled = true;
      button.textContent = "Saving...";

      try {
        const paymentPayload = {
          order_id: Number(orderId),
          payment_date: new Date(dateInput.value + "T12:00:00").toISOString(),
          amount: Number(amount.toFixed(2)),
          payment_mode: modeInput.value,
          reference_no: referenceInput.value.trim() || null,
          notes: notesInput.value.trim() || null,
          created_by: currentUser.id
        };

        const response = await supabaseFetch(
          "/rest/v1/payments",
          {
            method: "POST",
            headers: {
              "Prefer": "return=representation"
            },
            body: JSON.stringify(paymentPayload)
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.message ||
            "Unable to save payment."
          );
        }

        message.style.color = "#287a3e";
        message.textContent = "Payment recorded successfully.";

        await loadOrders();
        openOrderModal(orderId);
      } catch (error) {
        console.error("Payment Error:", error);
        message.style.color = "#b42318";
        message.textContent = error.message || "Unable to save payment.";
      } finally {
        if (document.getElementById("saveSalesmanPayment")) {
          document.getElementById("saveSalesmanPayment").disabled = false;
          document.getElementById("saveSalesmanPayment").textContent = "Save Payment";
        }
      }
    }

