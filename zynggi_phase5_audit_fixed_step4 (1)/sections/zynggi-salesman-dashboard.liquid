    async function loadShops() {



      const response =

        await supabaseFetch(

          "/rest/v1/shops" +

          "?select=*" +

          "&salesman_id=eq." +

          encodeURIComponent(

            currentUser.id

          ) +

          "&order=created_at.desc"

        );



