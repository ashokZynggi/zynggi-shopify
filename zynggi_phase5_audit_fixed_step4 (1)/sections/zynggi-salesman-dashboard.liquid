    async function loadProducts() {



      const response =

        await supabaseFetch(

          "/rest/v1/products" +

          "?select=*" +

          "&order=name.asc"

        );



      const data =

        await response.json();



      if (!response.ok) {

        document.getElementById(

          "productsList"

        ).innerHTML =

          '<div class="zynggi-list-card">' +

          "<strong>Products could not be loaded.</strong>" +

          "<p>Please check your Supabase products table and RLS policy.</p>" +

          "</div>";



        return;

      }



      products = data || [];



      renderProducts();

    }



    function renderProducts() {
      const container = document.getElementById("productsList");

      if (!products.length) {
        container.innerHTML =
          '<div class="zynggi-list-card">' +
          "<strong>No products found.</strong>" +
          "</div>";
        return;
      }

      container.innerHTML = products.map(function (product) {
        const productName =
          product.name ||
          product.product_name ||
          "Product";

        const productId = product.id;

        const price = Number(
          product.retailer_rate || 0
        );

        const mrp = Number(product.mrp || 0);
        const netWeight = product.net_weight || "";
        const packaging = product.packaging || "";
        const imageUrl = safeImageUrl(product.image_url);

        return `
          <div class="zynggi-product-card">
            <div class="zynggi-product-image-wrap">
              ${
                imageUrl
                  ? `
                    <img
                      src="${escapeHtml(imageUrl)}"
                      alt="${escapeHtml(productName)}"
                      class="zynggi-product-image"
                      loading="lazy"
                    >
                  `
                  : `
                    <div class="zynggi-product-image-placeholder">
                      <span>🌶️</span>
                      <small>No image</small>
                    </div>
                  `
              }
            </div>

            <div class="zynggi-product-card-content">
              <strong>
                ${escapeHtml(productName)}
              </strong>

              <div class="zynggi-product-meta">
                ${
                  netWeight
                    ? `<span>${escapeHtml(netWeight)}</span>`
                    : ""
                }

                ${
                  packaging
                    ? `<span>${escapeHtml(packaging)}</span>`
                    : ""
                }
              </div>

              <div class="zynggi-product-pricing">
                ${
                  mrp
                    ? `
                      <span>
                        MRP ₹${mrp.toFixed(2)}
                      </span>
                    `
                    : ""
                }

                ${
                  price
                    ? `
                      <strong>
                        Retailer ₹${price.toFixed(2)}
                      </strong>
                    `
                    : `
                      <strong>
                        Retailer rate not set
                      </strong>
                    `
                }
              </div>

              <div class="zynggi-product-card-row">
                <label for="qty-${escapeHtml(productId)}">
                  Qty
                </label>

                <input
                  id="qty-${escapeHtml(productId)}"
                  type="number"
                  min="0"
                  step="1"
                  value="0"
                  class="product-quantity"
                  data-product-id="${escapeHtml(productId)}"
                  data-product-name="${escapeHtml(productName)}"
                  data-product-price="${price}"
                >
              </div>
              <div class="zynggi-product-discount-row">
                <label for="discount-${escapeHtml(productId)}">Discount %</label>
                <input
                  id="discount-${escapeHtml(productId)}"
                  type="number"
                  min="0"
                  max="15"
                  step="0.01"
                  value="0"
                  class="product-discount"
                  data-product-id="${escapeHtml(productId)}"
                  inputmode="decimal"
                >
              </div>

              <div
                class="zynggi-product-final-rate"
                data-final-rate-for="${escapeHtml(productId)}"
              >
                Final Rate: <strong>₹${price.toFixed(2)}</strong>
              </div>


              <div class="zynggi-product-image-tools">
                <label class="zynggi-image-upload-button">
                  📷 ${
                    imageUrl
                      ? "Change Image"
                      : "Add Product Image"
                  }

                  <input
                    type="file"
                    class="product-image-input"
                    data-product-id="${escapeHtml(productId)}"
                    accept="image/jpeg,image/png,image/webp"
                    hidden
                  >
                </label>

                <small>
                  JPG, PNG or WebP
                </small>
              </div>
            </div>
          </div>
        `;
      }).join("");

      bindProductImageUploads();
    }

    async function bindProductImageUploads() {
      document
        .querySelectorAll(".product-image-input")
        .forEach(function (input) {
          input.addEventListener("change", async function (event) {
            const file = event.target.files[0];
            const productId = input.dataset.productId;

            if (!file || !productId) {
              return;
            }

            if (file.size > 5 * 1024 * 1024) {
              window.zynggiNotify("Please select an image smaller than 5 MB.");
              input.value = "";
              return;
            }

            const card = input.closest(".zynggi-product-card");
            const label = card
              ? card.querySelector(".zynggi-image-upload-button")
              : null;

            if (label) {
              label.dataset.originalText = label.textContent;
              label.textContent = "Uploading...";
              label.style.pointerEvents = "none";
              label.style.opacity = "0.6";
            }

            try {
              const extension =
                file.name.split(".").pop().toLowerCase() || "jpg";

              const filePath =
                `${productId}-${Date.now()}.${extension}`;

              const uploadResponse = await supabaseFetch(
                `/storage/v1/object/product-images/${encodeURIComponent(filePath)}`,
                {
                  method: "POST",
                  headers: {
                    "Content-Type": file.type,
                    "x-upsert": "true"
                  },
                  body: file
                }
              );

              const uploadData = await uploadResponse.json();

              if (!uploadResponse.ok) {
                throw new Error(
                  uploadData.message ||
                  uploadData.error ||
                  "Product image upload failed."
                );
              }

              const imageUrl =
                `${SUPABASE_URL}/storage/v1/object/public/product-images/${encodeURIComponent(filePath)}`;

              const updateResponse = await supabaseFetch(
                `/rest/v1/products?id=eq.${encodeURIComponent(productId)}`,
                {
                  method: "PATCH",
                  headers: {
                    "Prefer": "return=minimal"
                  },
                  body: JSON.stringify({
                    image_url: imageUrl
                  })
                }
              );

              if (!updateResponse.ok) {
                const updateData = await updateResponse.json();

                throw new Error(
                  updateData.message ||
                  updateData.details ||
                  "Image uploaded, but product image could not be saved."
                );
              }

              const product = products.find(function (item) {
                return String(item.id) === String(productId);
              });

              if (product) {
                product.image_url = imageUrl;
              }

              renderProducts();
            } catch (error) {
              console.error("Product Image Error:", error);
              window.zynggiNotify(
                error.message ||
                "Unable to upload product image."
              );

              if (label) {
                label.textContent =
                  label.dataset.originalText ||
                  "📷 Add Product Image";

                label.style.pointerEvents = "";
                label.style.opacity = "";
              }
            }
          });
        });
    }
    function getSelectedProducts() {

      const inputs = document.querySelectorAll(".product-quantity");
      const selected = [];

      inputs.forEach(function (input) {

        const quantity = Number(input.value || 0);

        if (quantity <= 0) {
          return;
        }

        const productId = input.dataset.productId;
        const baseRate = Number(input.dataset.productPrice || 0);

        const discountInput = document.querySelector(
          '.product-discount[data-product-id="' +
          CSS.escape(String(productId)) +
          '"]'
        );

        let discountPercent = Number(
          discountInput ? discountInput.value : 0
        );

        if (!Number.isFinite(discountPercent)) {
          discountPercent = 0;
        }

        discountPercent = Math.max(0, Math.min(15, discountPercent));

        if (discountInput) {
          discountInput.value = discountPercent;
        }

        const discountAmount = baseRate * discountPercent / 100;
        const finalRate = Math.max(0, baseRate - discountAmount);

        selected.push({
          productId: input.dataset.productId,
          productName: input.dataset.productName,
          quantity: quantity,
          price: finalRate,
          baseRate: baseRate,
          discountPercent: discountPercent,
          discountAmount: discountAmount
        });

      });

      return selected;

    }


    function updateOrderSummary() {

      const selected = getSelectedProducts();

      const totalItems = selected.reduce(
        function (total, item) {
          return total + item.quantity;
        },
        0
      );

      const discountAmount = selected.reduce(
        function (total, item) {
          return total + (item.discountAmount * item.quantity);
        },
        0
      );

      const netAmount = selected.reduce(
        function (total, item) {
          return total + (item.price * item.quantity);
        },
        0
      );

      document.getElementById("selectedItemCount").textContent =
        totalItems;

      document.getElementById("selectedProductCount").textContent =
        selected.length;

      const discountBox =
        document.getElementById("selectedDiscountAmount");

      const netBox =
        document.getElementById("selectedNetAmount");

      if (discountBox) {
        discountBox.textContent =
          "₹" + discountAmount.toFixed(2);
      }

      if (netBox) {
        netBox.textContent =
          "₹" + netAmount.toFixed(2);
      }

    }


    function updateProductFinalRates() {

      document.querySelectorAll(".product-quantity")
        .forEach(function (quantityInput) {

          const productId = quantityInput.dataset.productId;
          const baseRate = Number(
            quantityInput.dataset.productPrice || 0
          );

          const discountInput = document.querySelector(
            '.product-discount[data-product-id="' +
            CSS.escape(String(productId)) +
            '"]'
          );

          let discount = Number(
            discountInput ? discountInput.value : 0
          );

          if (!Number.isFinite(discount)) {
            discount = 0;
          }

          discount = Math.max(0, Math.min(15, discount));

          if (discountInput) {
            discountInput.value = discount;
          }

          const finalRate = Math.max(
            0,
            baseRate - (baseRate * discount / 100)
          );

          const finalRateElement = document.querySelector(
            '[data-final-rate-for="' +
            CSS.escape(String(productId)) +
            '"]'
          );

          if (finalRateElement) {
            finalRateElement.innerHTML =
              "Final Rate: <strong>₹" +
              finalRate.toFixed(2) +
              "</strong>";
          }

        });

    }


    async function loadOrders() {

      const response =
        await supabaseFetch(
          "/rest/v1/orders" +
          "?select=*" +
          "&salesman_id=eq." +
          encodeURIComponent(currentUser.id) +
          "&order=created_at.desc"
        );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
          "Unable to load orders."
        );
      }

      const itemResponse =
        await supabaseFetch(
          "/rest/v1/order_items?select=*" +
          "&order=id.asc"
        );

      const itemData = await itemResponse.json();

      if (!itemResponse.ok) {
        throw new Error(
          itemData.message ||
          "Unable to load order items."
        );
      }

      const paymentResponse =
        await supabaseFetch(
          "/rest/v1/payments?select=id,order_id,payment_date,amount,payment_mode,reference_no,notes,created_at,created_by" +
          "&order=payment_date.desc"
        );

      const paymentData = await paymentResponse.json();

      if (!paymentResponse.ok) {
        throw new Error(
          paymentData.message ||
          "Unable to load payment records."
        );
      }

      const orderIds = new Set(
        (data || []).map(function (order) {
          return String(order.id);
        })
      );

      allOrderItems = (itemData || []).filter(
        function (item) {
          return orderIds.has(String(item.order_id));
        }
      );

      allPayments = (paymentData || []).filter(
        function (payment) {
          return orderIds.has(String(payment.order_id));
        }
      );

      document.getElementById(
        "orderCount"
      ).textContent = data.length;

      renderOrders(data);
    }

    function orderItemsFor(orderId) {
      return allOrderItems.filter(
        function (item) {
          return String(item.order_id) === String(orderId);
        }
      );
    }

    function paymentsFor(orderId) {
      return allPayments.filter(
        function (payment) {
          return String(payment.order_id) === String(orderId);
        }
      );
    }

    function orderSubtotal(orderId) {
      return orderItemsFor(orderId).reduce(
        function (sum, item) {
          return sum +
            (Number(item.price || 0) * Number(item.quantity || 0));
        },
        0
      );
    }

    function orderGst(orderId) {
      return orderSubtotal(orderId) * 0.05;
    }

    function orderGrandTotal(orderId) {
      return orderSubtotal(orderId) + orderGst(orderId);
    }

    function paidTotal(orderId) {
      return paymentsFor(orderId).reduce(
        function (sum, payment) {
          return sum + Number(payment.amount || 0);
        },
        0
      );
    }

    function pendingTotal(orderId) {
      return Math.max(
        0,
        orderGrandTotal(orderId) - paidTotal(orderId)
      );
    }

    function paymentStatus(orderId) {
      const grand = orderGrandTotal(orderId);
      const paid = paidTotal(orderId);

      if (paid <= 0) return "Pending";
      if (paid + 0.01 >= grand) return "Paid";
      return "Partially Paid";
    }

    function formatMoney(value) {
      return "₹" + Number(value || 0).toLocaleString("en-IN", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function formatDate(value) {
      if (!value) return "-";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "-";
      return date.toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric"
      });
    }

    function formatDateInput(value) {
      const date = value ? new Date(value) : new Date();
      const local = new Date(
        date.getTime() - date.getTimezoneOffset() * 60000
      );
      return local.toISOString().slice(0, 10);
    }

    function shopForOrder(order) {
      return shops.find(
        function (shop) {
          return String(shop.id) === String(order.shop_id);
        }
      ) || null;
    }

    function invoiceNumber(order) {
      return "ZYG/" + new Date(order.created_at || Date.now()).getFullYear() + "/" + String(order.id).padStart(5, "0");
    }

