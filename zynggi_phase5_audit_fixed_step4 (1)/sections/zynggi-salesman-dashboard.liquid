<section class="zynggi-salesman-dashboard">



  <div class="zynggi-dashboard-container">



    <!-- HEADER -->

    <header class="zynggi-dashboard-header">



      <div>

        <div class="zynggi-dashboard-brand">

          ZYNGGI

        </div>



        <h1>

          Salesman Dashboard

        </h1>



        <p id="salesmanWelcome">

          Loading salesman details...

        </p>

      </div>



      <button

        type="button"

        id="salesmanLogout"

        class="zynggi-logout-button"

      >

        Logout

      </button>



    </header>



    <!-- LOADING -->

    <div

      id="dashboardLoading"

      class="zynggi-dashboard-loading"

    >

      Loading dashboard...

    </div>



    <!-- DASHBOARD -->

    <div

      id="dashboardContent"

      style="display: none;"

    >



      <!-- STATS -->

      <div class="zynggi-stat-grid">



        <div class="zynggi-stat-card">

          <span>My Shops</span>

          <strong id="shopCount">0</strong>

        </div>



        <div class="zynggi-stat-card">

          <span>My Orders</span>

          <strong id="orderCount">0</strong>

        </div>



        <div class="zynggi-stat-card">

          <span>Status</span>

          <strong id="salesmanStatus">

            Active

          </strong>

        </div>



      </div>



      <!-- ACTIONS -->

      <div class="zynggi-action-grid">



        <button

          type="button"

          class="zynggi-action-card"

          data-target="shopSection"

        >

          <span class="zynggi-action-icon">

            🏪

          </span>



          <strong>

            Add New Shop

          </strong>



          <small>

            Register a new retailer

          </small>

        </button>



        <button

          type="button"

          class="zynggi-action-card"

          data-target="shopsListSection"

        >

          <span class="zynggi-action-icon">

            📍

          </span>



          <strong>

            My Shops

          </strong>



          <small>

            View registered shops

          </small>

        </button>



        <button

          type="button"

          class="zynggi-action-card"

          data-target="orderSection"

        >

          <span class="zynggi-action-icon">

            🛒

          </span>



          <strong>

            Create New Order

          </strong>



          <small>

            Take order from a shop

          </small>

        </button>



        <button

          type="button"

          class="zynggi-action-card"

          data-target="ordersListSection"

        >

          <span class="zynggi-action-icon">

            📦

          </span>



          <strong>

            My Orders

          </strong>



          <small>

            View order history

          </small>

        </button>



      </div>



      <!-- ADD SHOP -->

      <section

        id="shopSection"

        class="zynggi-dashboard-section"

      >



        <div class="zynggi-section-heading">

          <div>

            <span>SHOP MANAGEMENT</span>



            <h2>

              Add New Shop

            </h2>

          </div>

        </div>



        <form id="shopForm">



          <div class="zynggi-form-grid">



            <div class="zynggi-form-field">

              <label for="shopName">

                Shop Name *

              </label>



              <input

                type="text"

                id="shopName"

                required

                placeholder="Enter shop name"

              >

            </div>



            <div class="zynggi-form-field">

              <label for="ownerName">

                Owner Name

              </label>



              <input

                type="text"

                id="ownerName"

                placeholder="Shop owner name"

              >

            </div>



            <div class="zynggi-form-field">

              <label for="shopMobile">

                Mobile Number

              </label>



              <input

                type="tel"

                id="shopMobile"

                placeholder="Enter mobile number"

              >

            </div>



            <div class="zynggi-form-field">

              <label for="shopPincode">

                Pincode

              </label>



              <input

                type="text"

                id="shopPincode"

                placeholder="Pincode"

              >

            </div>



            <div class="zynggi-form-field full-width">

              <label for="shopAddress">

                Address

              </label>



              <textarea

                id="shopAddress"

                rows="3"

                placeholder="Complete shop address"

              ></textarea>

            </div>



            <div class="zynggi-form-field">

              <label for="shopCity">

                City

              </label>



              <input

                type="text"

                id="shopCity"

                placeholder="City"

              >

            </div>



            <div class="zynggi-form-field">

              <label for="shopPhoto">

                Shop Photo

              </label>



              <input

                type="file"

                id="shopPhoto"

                accept="image/*"

                capture="environment"

              >



              <small>

                Take a photo of the shop.

              </small>

            </div>



          </div>



          <div class="zynggi-location-box">



            <div>

              <strong>

                📍 Shop Location

              </strong>



              <p id="locationStatus">

                Location not captured

              </p>

            </div>



            <button

              type="button"

              id="getLocationButton"

              class="zynggi-secondary-button"

            >

              Get Current Location

            </button>



          </div>



          <input

            type="hidden"

            id="shopLatitude"

          >



          <input

            type="hidden"

            id="shopLongitude"

          >



          <button

            type="submit"

            id="saveShopButton"

            class="zynggi-primary-button"

          >

            Save Shop

          </button>



          <div

            id="shopMessage"

            class="zynggi-message"

          ></div>



        </form>



      </section>



      <!-- MY SHOPS -->

      <section

        id="shopsListSection"

        class="zynggi-dashboard-section"

      >



        <div class="zynggi-section-heading">



          <div>

            <span>SHOP NETWORK</span>



            <h2>

              My Shops

            </h2>

          </div>



          <button

            type="button"

            id="refreshShops"

            class="zynggi-small-button"

          >

            Refresh

          </button>



        </div>



        <div

          id="shopsList"

          class="zynggi-list"

        >

          Loading shops...

        </div>



      </section>



      <!-- CREATE ORDER -->

      <section

        id="orderSection"

        class="zynggi-dashboard-section"

      >



        <div class="zynggi-section-heading">



          <div>

            <span>SALES ORDER</span>



            <h2>

              Create New Order

            </h2>

          </div>



        </div>



        <div class="zynggi-form-grid">



          <div class="zynggi-form-field full-width">

            <label for="orderShop">

              Select Shop *

            </label>



            <select id="orderShop">

              <option value="">

                Select shop

              </option>

            </select>

          </div>



        </div>



        <div class="zynggi-product-area">



          <h3>

            Select Products

          </h3>

          <p class="zynggi-product-rate-note">
            Retailer rate is shown below each product. You can apply up to 15% discount per product.
          </p>



          <div

            id="productsList"

            class="zynggi-products-grid"

          >

            Loading products...

          </div>



        </div>



        <div class="zynggi-order-summary">



          <div>

            <span>

              Total Items

            </span>



            <strong id="selectedItemCount">

              0

            </strong>

          </div>



          <div>

            <span>

              Products Selected

            </span>



            <strong id="selectedProductCount">

              0

            </strong>

          </div>
          <div>
            <span>Discount</span>
            <strong id="selectedDiscountAmount">₹0.00</strong>
          </div>

          <div>
            <span>Net Amount</span>
            <strong id="selectedNetAmount">₹0.00</strong>
          </div>



        </div>



        <div class="zynggi-form-field">



          <label for="orderNotes">

            Notes

          </label>



          <textarea

            id="orderNotes"

            rows="4"

            placeholder="Any special requirement..."

          ></textarea>



        </div>



        <button

          type="button"

          id="submitOrderButton"

          class="zynggi-primary-button"

        >

          Confirm Order

        </button>



        <div

          id="orderMessage"

          class="zynggi-message"

        ></div>



      </section>



      <!-- ORDERS -->

      <section

        id="ordersListSection"

        class="zynggi-dashboard-section"

      >



        <div class="zynggi-section-heading">



          <div>

            <span>SALES HISTORY</span>



            <h2>

              My Orders

            </h2>

          </div>



          <button

            type="button"

            id="refreshOrders"

            class="zynggi-small-button"

          >

            Refresh

          </button>



        </div>



        <div

          id="ordersList"

          class="zynggi-list"

        >

          Loading orders...

        </div>



      </section>



      <!-- PAYMENT / BILL MODAL -->
      <div
        id="salesmanOrderModal"
        class="zynggi-order-modal"
        aria-hidden="true"
      >
        <div class="zynggi-order-modal-backdrop" id="salesmanOrderModalBackdrop"></div>
        <div class="zynggi-order-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="salesmanOrderModalTitle">
          <div class="zynggi-order-modal-header">
            <div>
              <span>ORDER MANAGEMENT</span>
              <h2 id="salesmanOrderModalTitle">Order Details</h2>
            </div>
            <button type="button" id="closeSalesmanOrderModal" class="zynggi-modal-close">×</button>
          </div>
          <div id="salesmanOrderModalContent" class="zynggi-order-modal-content">Loading...</div>
        </div>
      </div>



    </div>



  </div>



</section>



<style>

  .zynggi-salesman-dashboard {

    min-height: 100vh;

    padding: 40px 20px 80px;

    background: #f7f3ed;

  }



  .zynggi-dashboard-container {

    max-width: 1200px;

    margin: 0 auto;

  }



  .zynggi-dashboard-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 35px;

  }



  .zynggi-dashboard-brand {

    margin-bottom: 8px;

    color: #9a6a3a;

    font-size: 18px;

    font-weight: 800;

    letter-spacing: 4px;

  }



  .zynggi-dashboard-header h1 {

    margin: 0 0 8px;

    color: #24170e;

    font-size: 34px;

  }



  .zynggi-dashboard-header p {

    margin: 0;

    color: #75685e;

  }



  .zynggi-logout-button,

  .zynggi-small-button,

  .zynggi-secondary-button {

    border: 1px solid #d6c6b5;

    border-radius: 9px;

    background: #ffffff;

    color: #6f4726;

    cursor: pointer;

    font-weight: 600;

  }



  .zynggi-logout-button {

    padding: 11px 20px;

  }



  .zynggi-small-button {

    padding: 9px 15px;

  }



  .zynggi-secondary-button {

    padding: 11px 16px;

  }



  .zynggi-dashboard-loading {

    padding: 60px 20px;

    text-align: center;

    color: #75685e;

  }



  .zynggi-stat-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 18px;

    margin-bottom: 25px;

  }



  .zynggi-stat-card {

    padding: 24px;

    border: 1px solid #e4d9ce;

    border-radius: 14px;

    background: #fffdfa;

  }



  .zynggi-stat-card span {

    display: block;

    margin-bottom: 8px;

    color: #81746a;

    font-size: 13px;

  }



  .zynggi-stat-card strong {

    color: #2d1c11;

    font-size: 28px;

  }



  .zynggi-action-grid {

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 16px;

    margin-bottom: 30px;

  }



  .zynggi-action-card {

    padding: 24px 18px;

    border: 1px solid #e1d5c9;

    border-radius: 14px;

    background: #fffdfa;

    text-align: left;

    cursor: pointer;

    transition: 0.2s ease;

  }



  .zynggi-action-card:hover {

    transform: translateY(-2px);

    border-color: #b99673;

    box-shadow: 0 10px 25px rgba(75, 48, 25, 0.08);

  }



  .zynggi-action-icon {

    display: block;

    margin-bottom: 12px;

    font-size: 27px;

  }



  .zynggi-action-card strong {

    display: block;

    margin-bottom: 6px;

    color: #2d1c11;

  }



  .zynggi-action-card small {

    color: #81746a;

  }



  .zynggi-dashboard-section {

    margin-bottom: 30px;

    padding: 28px;

    border: 1px solid #e4d9ce;

    border-radius: 16px;

    background: #fffdfa;

  }



  .zynggi-section-heading {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    margin-bottom: 24px;

  }



  .zynggi-section-heading span {

    color: #9a6a3a;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 2px;

  }



  .zynggi-section-heading h2 {

    margin: 6px 0 0;

    color: #2d1c11;

    font-size: 25px;

  }



  .zynggi-form-grid {

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 18px;

  }



  .zynggi-form-field {

    margin-bottom: 18px;

  }



  .zynggi-form-field.full-width {

    grid-column: 1 / -1;

  }



  .zynggi-form-field label {

    display: block;

    margin-bottom: 7px;

    color: #3a2a1e;

    font-size: 14px;

    font-weight: 600;

  }



  .zynggi-form-field input,

  .zynggi-form-field select,

  .zynggi-form-field textarea {

    width: 100%;

    box-sizing: border-box;

    padding: 13px 14px;

    border: 1px solid #d8c9ba;

    border-radius: 9px;

    background: #ffffff;

    color: #24170e;

    font-size: 14px;

  }



  .zynggi-form-field textarea {

    resize: vertical;

  }



  .zynggi-form-field small {

    display: block;

    margin-top: 6px;

    color: #81746a;

    font-size: 12px;

  }



  .zynggi-location-box {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    margin: 5px 0 20px;

    padding: 15px;

    border: 1px solid #e4d9ce;

    border-radius: 10px;

    background: #f9f5ef;

  }



  .zynggi-location-box strong {

    color: #2d1c11;

  }



  .zynggi-location-box p {

    margin: 5px 0 0;

    color: #81746a;

    font-size: 13px;

  }



  .zynggi-primary-button {

    width: 100%;

    padding: 14px 20px;

    border: 0;

    border-radius: 9px;

    background: #8b5e34;

    color: #ffffff;

    font-size: 15px;

    font-weight: 700;

    cursor: pointer;

  }



  .zynggi-primary-button:hover {

    background: #6f4726;

  }



  .zynggi-primary-button:disabled {

    opacity: 0.6;

    cursor: not-allowed;

  }



  .zynggi-message {

    min-height: 22px;

    margin-top: 12px;

    font-size: 14px;

  }



  .zynggi-product-area {

    margin-top: 10px;

  }



    .zynggi-product-image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    margin: -16px -16px 16px;
    background: #f5eee6;
  }

  .zynggi-product-image {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: contain;
    background: #f5eee6;
  }

  .zynggi-product-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    width: 100%;
    height: 150px;
    color: #8a796a;
  }

  .zynggi-product-image-placeholder span {
    font-size: 34px;
  }

  .zynggi-product-image-placeholder small {
    font-size: 11px;
  }

  .zynggi-product-card-content > strong {
    min-height: 38px;
  }

  .zynggi-product-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 7px 0 10px;
  }

  .zynggi-product-meta span {
    padding: 4px 7px;
    border-radius: 5px;
    background: #f1e9df;
    color: #6f5b4a;
    font-size: 11px;
  }

  .zynggi-product-pricing {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 12px;
  }

  .zynggi-product-pricing span {
    color: #81746a;
    font-size: 12px;
  }

  .zynggi-product-pricing strong {
    color: #8b5e34;
    font-size: 15px;
  }

  .zynggi-product-image-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid #eee3d8;
  }

  .zynggi-image-upload-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    border: 1px solid #d6c6b5;
    border-radius: 7px;
    background: #fffaf4;
    color: #6f4726;
    cursor: pointer;
    font-size: 11px;
    font-weight: 700;
  }

  .zynggi-product-image-tools small {
    color: #8b7d70;
    font-size: 10px;
    text-align: right;
  }

  .zynggi-product-rate-note {
    margin: -8px 0 18px;
    color: #81746a;
    font-size: 13px;
  }

.zynggi-product-area h3 {

    margin-bottom: 15px;

    color: #2d1c11;

  }



  .zynggi-products-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 14px;

    margin-bottom: 24px;

  }



  .zynggi-product-card {

    padding: 16px;

    border: 1px solid #e4d9ce;

    border-radius: 11px;

    background: #ffffff;

  }



  .zynggi-product-card strong {

    display: block;

    margin-bottom: 10px;

    color: #2d1c11;

    font-size: 14px;

  }



    .zynggi-product-discount-row {
    display: grid;
    grid-template-columns: 1fr 90px;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
  }

  .zynggi-product-discount-row label {
    color: #6f6258;
    font-size: 12px;
    font-weight: 700;
  }

  .zynggi-product-discount-row input {
    width: 100% !important;
    box-sizing: border-box;
    padding: 9px 8px !important;
    border: 1px solid #d8c9ba;
    border-radius: 7px;
    background: #fff;
    color: #24170e;
    font-size: 13px;
    font-weight: 700;
  }

  .zynggi-product-final-rate {
    margin-top: 9px;
    padding: 8px 10px;
    border-radius: 7px;
    background: #f7f1e9;
    color: #75685e;
    font-size: 12px;
  }

  .zynggi-product-final-rate strong {
    color: #6f4726;
  }

.zynggi-product-card-row {

    display: flex;

    align-items: center;

    gap: 8px;

  }



  .zynggi-product-card input {

    width: 80px;

    padding: 9px;

    border: 1px solid #d8c9ba;

    border-radius: 7px;

  }



  .zynggi-order-summary {

    display: flex;

    gap: 25px;

    margin: 15px 0 20px;

    padding: 16px;

    border-radius: 10px;

    background: #f7f1e9;

  }



  .zynggi-order-summary span {

    display: block;

    color: #81746a;

    font-size: 12px;

  }



  .zynggi-order-summary strong {

    display: block;

    margin-top: 4px;

    color: #2d1c11;

    font-size: 20px;

  }



  .zynggi-list {

    display: grid;

    gap: 12px;

  }



  .zynggi-list-card {

    padding: 17px;

    border: 1px solid #e4d9ce;

    border-radius: 10px;

    background: #fffdfa;

  }



  .zynggi-list-card-header {

    display: flex;

    justify-content: space-between;

    gap: 15px;

  }



  .zynggi-list-card strong {

    color: #2d1c11;

  }



  .zynggi-list-card p {

    margin: 5px 0;

    color: #81746a;

    font-size: 13px;

  }



  .zynggi-order-status {

    display: inline-block;

    padding: 5px 9px;

    border-radius: 20px;

    background: #eee4d7;

    color: #6f4726;

    font-size: 11px;

    font-weight: 700;

  }



  @media screen and (max-width: 900px) {

    .zynggi-action-grid {

      grid-template-columns: repeat(2, 1fr);

    }



    .zynggi-products-grid {

      grid-template-columns: repeat(2, 1fr);

    }

  }



  @media screen and (max-width: 650px) {

    .zynggi-salesman-dashboard {

      padding: 25px 14px 60px;

    }



    .zynggi-dashboard-header {

      align-items: flex-start;

      flex-direction: column;

    }



    .zynggi-dashboard-header h1 {

      font-size: 28px;

    }



    .zynggi-stat-grid {

      grid-template-columns: 1fr;

    }



    .zynggi-action-grid {

      grid-template-columns: 1fr 1fr;

    }



    .zynggi-form-grid {

      grid-template-columns: 1fr;

    }



    .zynggi-form-field.full-width {

      grid-column: auto;

    }



    .zynggi-products-grid {

      grid-template-columns: 1fr;

    }



    .zynggi-location-box {

      align-items: flex-start;

      flex-direction: column;

    }

    .zynggi-product-image,
    .zynggi-product-image-placeholder {
      height: 135px;
    }

    .zynggi-product-image-wrap {
      min-height: 135px;
    }

  }


  .zynggi-order-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
  }

  .zynggi-order-modal.is-open {
    display: block;
  }

  .zynggi-order-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(25, 18, 12, 0.58);
    backdrop-filter: blur(2px);
  }

  .zynggi-order-modal-dialog {
    position: relative;
    width: min(980px, calc(100vw - 28px));
    max-height: calc(100vh - 28px);
    overflow: auto;
    margin: 14px auto;
    background: #fffdf9;
    border: 1px solid #e6d9ca;
    border-radius: 16px;
    box-shadow: 0 24px 70px rgba(0,0,0,.22);
  }

  .zynggi-order-modal-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
