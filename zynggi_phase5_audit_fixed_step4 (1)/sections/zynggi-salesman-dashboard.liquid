          "<p>Add your first retailer above.</p>" +

          "</div>";



        return;

      }



      container.innerHTML =

        shops.map(function (shop) {



          return `

            <div class="zynggi-list-card">

              <div class="zynggi-list-card-header">

                <strong>

                  ${escapeHtml(

                    shop.shop_name ||

                    "Unnamed Shop"

                  )}

                </strong>

              </div>



              <p>

                Owner:

                ${escapeHtml(

                  shop.owner_name || "-"

                )}

              </p>



              <p>

                Mobile:

                ${escapeHtml(

                  shop.mobile || "-"

                )}

              </p>



              <p>

                ${escapeHtml(

                  shop.address || ""

                )}

                ${

                  shop.city

                    ? ", " +

                      escapeHtml(shop.city)

                    : ""

                }

              </p>

            </div>

          `;



        }).join("");

    }



    function populateShopSelect() {



      const select =

        document.getElementById(

          "orderShop"

        );



      select.innerHTML =

        '<option value="">Select shop</option>';



      shops.forEach(function (shop) {



        const option =

          document.createElement(

            "option"

          );



