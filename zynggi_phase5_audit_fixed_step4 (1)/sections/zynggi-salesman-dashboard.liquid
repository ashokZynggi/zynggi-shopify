      return true;

    }



    async function loadSalesman() {



      const response =

        await supabaseFetch(

          "/rest/v1/salesmen" +

          "?select=id,salesman_code,name,mobile,area,role,status" +

          "&user_id=eq." +

          encodeURIComponent(currentUser.id) +

          "&limit=1"

        );



      const data =

        await response.json();



      if (!response.ok) {

        throw new Error(

          data.message ||

          "Unable to load salesman details."

        );

      }



      if (!Array.isArray(data) || !data.length) {

        throw new Error(

          "Salesman account not found."

        );

      }



      currentSalesman = data[0];

      const userRole = String(
        currentSalesman.role || ""
      ).trim().toLowerCase();

      if (userRole === "admin") {
        window.location.href = "/pages/pages-zynggi-admin";
        return;
      }

      if (userRole !== "salesman") {
        throw new Error("Unauthorized dashboard access.");
      }

      if (
        String(currentSalesman.status || "").trim().toLowerCase() !==
        "active"
      ) {

        throw new Error(

          "Your salesman account is inactive."

        );

      }



