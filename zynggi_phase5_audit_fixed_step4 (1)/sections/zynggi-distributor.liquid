{% comment %}
  ZYNGGI DISTRIBUTOR PARTNERSHIP (UX/CRO redesign)
  File: sections/zynggi-distributor.liquid

  Strategy:
  - Short primary enquiry (essentials only) → submit in <30s
  - "Add business information" toggle reveals the full application
  - WhatsApp as a low-friction secondary path
  - All original contact[...] field names preserved
  - CSS scoped to section ID — homepage untouched
{% endcomment %}

<section id="ZynggiDistributor-{{ section.id }}" class="zynggi-distributor">
  <div class="zynggi-distributor__container">

    {%- comment -%} ================= HERO ================= {%- endcomment -%}
    <div
      class="zynggi-distributor__hero"
      {% if section.settings.hero_image != blank %}
        style="background-image:
          linear-gradient(
            90deg,
            rgba(35,20,14,{{ section.settings.hero_overlay | divided_by: 100.0 }}) 0%,
            rgba(45,27,20,{{ section.settings.hero_overlay | times: 0.75 | divided_by: 100.0 }}) 48%,
            rgba(45,27,20,{{ section.settings.hero_overlay | times: 0.25 | divided_by: 100.0 }}) 100%
          ),
          url('{{ section.settings.hero_image | image_url: width: 2200 }}');"
      {% endif %}
    >
      <div class="zynggi-distributor__hero-content">
        {% if section.settings.hero_eyebrow != blank %}
          <span class="zynggi-distributor__eyebrow">{{ section.settings.hero_eyebrow }}</span>
        {% endif %}

        <h1>{{ section.settings.hero_heading }}</h1>

        {% if section.settings.hero_text != blank %}
          <p>{{ section.settings.hero_text }}</p>
        {% endif %}

        <div class="zynggi-distributor__hero-cta">
          {% if section.settings.hero_button_text != blank %}
            <a href="#DistributorApplication-{{ section.id }}" class="zynggi-distributor__btn zynggi-distributor__btn--primary" data-zynggi-scroll>
              {{ section.settings.hero_button_text }}
              <span aria-hidden="true">→</span>
            </a>
          {% endif %}

          {% if section.settings.whatsapp_number != blank %}
            <a
              class="zynggi-distributor__btn zynggi-distributor__btn--ghost"
              href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | default: 'Hi Zynggi, I am interested in becoming a distributor.' | url_encode }}"
              target="_blank" rel="noopener"
            >Talk to Zynggi</a>
          {% endif %}
        </div>

        <ul class="zynggi-distributor__hero-points">
          <li>No payment to apply</li>
          <li>Reply within 1 working day</li>
          <li>Territory-based partnership</li>
        </ul>
      </div>
    </div>

    {%- comment -%} ================= WHY ZYNGGI ================= {%- endcomment -%}
    <div class="zynggi-distributor__section">
      <div class="zynggi-distributor__section-heading">
        <span class="zynggi-distributor__number" aria-hidden="true">01</span>
        <div>
          <span class="zynggi-distributor__label">{{ section.settings.why_eyebrow }}</span>
          <h2>{{ section.settings.why_heading }}</h2>
          <p>{{ section.settings.why_text }}</p>
        </div>
      </div>

      <div class="zynggi-distributor__benefits">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            <div class="zynggi-distributor__benefit" {{ block.shopify_attributes }}>
              <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {%- comment -%} ================= WHO CAN PARTNER ================= {%- endcomment -%}
    <div class="zynggi-distributor__section zynggi-distributor__section--soft">
      <div class="zynggi-distributor__section-heading">
        <span class="zynggi-distributor__number" aria-hidden="true">02</span>
        <div>
          <span class="zynggi-distributor__label">{{ section.settings.who_eyebrow }}</span>
          <h2>{{ section.settings.who_heading }}</h2>
          <p>{{ section.settings.who_text }}</p>
        </div>
      </div>

      <div class="zynggi-distributor__audience-grid">
        {% for block in section.blocks %}
          {% if block.type == 'audience' %}
            <div class="zynggi-distributor__audience-card" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title }}</strong>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {%- comment -%} ================= HOW IT WORKS ================= {%- endcomment -%}
    <div class="zynggi-distributor__section">
      <div class="zynggi-distributor__section-heading">
        <span class="zynggi-distributor__number" aria-hidden="true">03</span>
        <div>
          <span class="zynggi-distributor__label">{{ section.settings.process_eyebrow }}</span>
          <h2>{{ section.settings.process_heading }}</h2>
          <p>{{ section.settings.process_text }}</p>
        </div>
      </div>

      <div class="zynggi-distributor__steps">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <div class="zynggi-distributor__step" {{ block.shopify_attributes }}>
              <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {%- comment -%} ================= APPLICATION ================= {%- endcomment -%}
    <div id="DistributorApplication-{{ section.id }}" class="zynggi-distributor__application">
      <div class="zynggi-distributor__application-header">
        <span class="zynggi-distributor__eyebrow">{{ section.settings.form_eyebrow }}</span>
        <h2>{{ section.settings.form_heading }}</h2>
        <p>{{ section.settings.form_text }}</p>
      </div>

      {% form 'contact', id: 'ZynggiDistributorForm' %}

        {%- if form.posted_successfully? -%}
          <div class="zynggi-distributor__notice zynggi-distributor__notice--success" role="status">
            <strong>Thank you — your enquiry has been received.</strong>
            <p>Our team will review your details and contact you to discuss your market and the distribution opportunity.</p>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="zynggi-distributor__notice zynggi-distributor__notice--error" role="alert">
            <strong>Please check the highlighted fields and try again.</strong>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- comment -%} ============== ESSENTIALS ============== {%- endcomment -%}
        <div class="zynggi-distributor__card">
          <div class="zynggi-distributor__card-heading">
            <span aria-hidden="true">01</span>
            <div>
              <h3>Start your enquiry</h3>
              <p>Just the essentials — you can share more details after this if you like.</p>
            </div>
          </div>

          <div class="zynggi-distributor__grid">
            <div class="zynggi-distributor__field">
              <label for="DistributorName-{{ section.id }}">Full name <span aria-hidden="true">*</span></label>
              <input
                id="DistributorName-{{ section.id }}"
                type="text"
                name="contact[Full Name]"
                placeholder="Your full name"
                autocomplete="name"
                required
              >
            </div>

            <div class="zynggi-distributor__field">
              <label for="DistributorPhone-{{ section.id }}">Phone number <span aria-hidden="true">*</span></label>
              <input
                id="DistributorPhone-{{ section.id }}"
                type="tel"
                name="contact[Phone]"
                placeholder="+91 XXXXX XXXXX"
                autocomplete="tel"
                inputmode="tel"
                required
              >
            </div>

            <div class="zynggi-distributor__field">
              <label for="DistributorCity-{{ section.id }}">City / District <span aria-hidden="true">*</span></label>
              <input
                id="DistributorCity-{{ section.id }}"
                type="text"
                name="contact[City]"
                placeholder="Where do you want to distribute?"
                autocomplete="address-level2"
                required
              >
            </div>

            <div class="zynggi-distributor__field">
              <label for="DistributorBusinessType-{{ section.id }}">Business type</label>
              <select id="DistributorBusinessType-{{ section.id }}" name="contact[Business Type]">
                <option value="">Select business type</option>
                <option value="FMCG Distributor">FMCG Distributor</option>
                <option value="Spice Distributor">Spice Distributor</option>
                <option value="Grocery Wholesaler">Grocery Wholesaler</option>
                <option value="Super Stockist">Super Stockist</option>
                <option value="Retail Network">Retail Network</option>
                <option value="Food Business">Food Business</option>
                <option value="Manufacturer">Manufacturer</option>
                <option value="New Entrepreneur">New Entrepreneur</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="zynggi-distributor__field zynggi-distributor__field--full">
              <label for="DistributorExperience-{{ section.id }}">Do you currently distribute FMCG or spices?</label>
              <select id="DistributorExperience-{{ section.id }}" name="contact[Existing Distribution Experience]">
                <option value="">Select one</option>
                <option value="Yes - FMCG / Spices">Yes — in FMCG / Spices</option>
                <option value="Yes - different category">Yes — but a different category</option>
                <option value="No - new to distribution">No — I'm new to distribution</option>
              </select>
            </div>

            <div class="zynggi-distributor__field zynggi-distributor__field--full">
              <label for="DistributorMessage-{{ section.id }}">Anything you'd like to discuss? <span class="zynggi-distributor__optional">(optional)</span></label>
              <textarea
                id="DistributorMessage-{{ section.id }}"
                name="contact[Message]"
                rows="3"
                placeholder="Example: I want to distribute Zynggi in Nagpur district. I currently supply ~80 retail shops."
              ></textarea>
            </div>
          </div>

          <button type="submit" class="zynggi-distributor__submit-btn">
            <span>{{ section.settings.submit_button_text | default: 'Start My Distributor Enquiry' }}</span>
            <span aria-hidden="true">→</span>
          </button>

          <p class="zynggi-distributor__submit-note">
            {{ section.settings.submit_note | default: "No payment required. Our team will contact you to discuss your market and the distribution opportunity." }}
          </p>

          {% if section.settings.whatsapp_number != blank %}
            <p class="zynggi-distributor__submit-wa">
              Prefer to talk first?
              <a
                href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | default: 'Hi Zynggi, I am interested in becoming a distributor.' | url_encode }}"
                target="_blank" rel="noopener"
              >Chat on WhatsApp →</a>
            </p>
          {% endif %}
        </div>

        {%- comment -%} ============== OPTIONAL DETAILS (progressive disclosure) ============== {%- endcomment -%}
        <div class="zynggi-distributor__advanced" data-zynggi-advanced>
          <button
            type="button"
            class="zynggi-distributor__advanced-toggle"
            aria-expanded="false"
            aria-controls="DistributorAdvanced-{{ section.id }}"
            data-zynggi-advanced-toggle
          >
            <span class="zynggi-distributor__advanced-toggle-text">
              <strong>Want to add more details?</strong>
              <small>Optional — helps our team review your enquiry faster.</small>
            </span>
            <span class="zynggi-distributor__advanced-toggle-icon" aria-hidden="true"></span>
          </button>

          <div id="DistributorAdvanced-{{ section.id }}" class="zynggi-distributor__advanced-body" hidden>

            {%- comment -%} ---- 02 — Business information ---- {%- endcomment -%}
            <details class="zynggi-distributor__details" open>
              <summary>
                <span aria-hidden="true">02</span>
                <span>Business information</span>
              </summary>
              <div class="zynggi-distributor__details-body">
                <div class="zynggi-distributor__grid">
                  <div class="zynggi-distributor__field">
                    <label for="DistributorBusiness-{{ section.id }}">Business name</label>
                    <input
                      id="DistributorBusiness-{{ section.id }}"
                      type="text"
                      name="contact[Business Name]"
                      placeholder="Your business name"
                      autocomplete="organization"
                    >
                  </div>

                  <div class="zynggi-distributor__field">
                    <label for="DistributorEmail-{{ section.id }}">Email <span class="zynggi-distributor__optional">(optional)</span></label>
                    <input
                      id="DistributorEmail-{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      placeholder="you@example.com"
                      autocomplete="email"
                    >
                  </div>

                  <div class="zynggi-distributor__field">
                    <label for="DistributorGST-{{ section.id }}">GST number <span class="zynggi-distributor__optional">(optional)</span></label>
                    <input
                      id="DistributorGST-{{ section.id }}"
                      type="text"
                      name="contact[GST Number]"
                      placeholder="GSTIN, if applicable"
                    >
                  </div>

                  <div class="zynggi-distributor__field">
                    <label for="DistributorYears-{{ section.id }}">Years in business</label>
                    <select id="DistributorYears-{{ section.id }}" name="contact[Years in Business]">
                      <option value="">Select</option>
                      <option value="New Business">New Business</option>
                      <option value="Less than 1 year">Less than 1 year</option>
                      <option value="1 - 3 years">1 – 3 years</option>
                      <option value="3 - 5 years">3 – 5 years</option>
                      <option value="5 - 10 years">5 – 10 years</option>
                      <option value="10+ years">10+ years</option>
                    </select>
                  </div>
                </div>
              </div>
            </details>

            {%- comment -%} ---- 03 — Market & territory ---- {%- endcomment -%}
            <details class="zynggi-distributor__details">
              <summary>
                <span aria-hidden="true">03</span>
                <span>Market &amp; territory</span>
              </summary>
              <div class="zynggi-distributor__details-body">
                <div class="zynggi-distributor__grid">
                  <div class="zynggi-distributor__field">
                    <label for="DistributorState-{{ section.id }}">State</label>
                    <input id="DistributorState-{{ section.id }}" type="text" name="contact[State]" placeholder="State" autocomplete="address-level1">
                  </div>
                  <div class="zynggi-distributor__field">
                    <label for="DistributorDistrict-{{ section.id }}">District</label>
                    <input id="DistributorDistrict-{{ section.id }}" type="text" name="contact[District]" placeholder="District">
                  </div>
                  <div class="zynggi-distributor__field">
                    <label for="DistributorPincode-{{ section.id }}">Pincode</label>
                    <input id="DistributorPincode-{{ section.id }}" type="text" name="contact[Pincode]" placeholder="Pincode" inputmode="numeric" autocomplete="postal-code">
                  </div>
                  <div class="zynggi-distributor__field">
                    <label for="DistributorTerritory-{{ section.id }}">Preferred territory</label>
                    <select id="DistributorTerritory-{{ section.id }}" name="contact[Preferred Territory]">
                      <option value="">Select</option>
                      <option value="City">City</option>
                      <option value="District">District</option>
                      <option value="Multiple Districts">Multiple Districts</option>
                      <option value="State">State</option>
                      <option value="Multiple States">Multiple States</option>
                      <option value="Not Sure">Not Sure</option>
                    </select>
                  </div>
                  <div class="zynggi-distributor__field zynggi-distributor__field--full">
                    <label for="DistributorRetailers-{{ section.id }}">Current retailer network</label>
                    <select id="DistributorRetailers-{{ section.id }}" name="contact[Current Retailer Network]">
                      <option value="">Select approximate network</option>
                      <option value="No Retail Network">No retail network</option>
                      <option value="1 - 25">1 – 25 shops</option>
                      <option value="26 - 50">26 – 50 shops</option>
                      <option value="51 - 100">51 – 100 shops</option>
                      <option value="101 - 250">101 – 250 shops</option>
                      <option value="251 - 500">251 – 500 shops</option>
                      <option value="500+">500+ shops</option>
                    </select>
                  </div>
                </div>
              </div>
            </details>

            {%- comment -%} ---- 04 — Distribution capability ---- {%- endcomment -%}
            <details class="zynggi-distributor__details">
              <summary>
                <span aria-hidden="true">04</span>
                <span>Distribution capability</span>
              </summary>
              <div class="zynggi-distributor__details-body">
                <div class="zynggi-distributor__capability-grid">
                  <label class="zynggi-distributor__check-card">
                    <input type="checkbox" name="contact[Capability - Warehouse]" value="Available">
                    <span>
                      <strong>Warehouse / Storage</strong>
                      <small>Storage space for FMCG products.</small>
                    </span>
                  </label>
                  <label class="zynggi-distributor__check-card">
                    <input type="checkbox" name="contact[Capability - Delivery Vehicle]" value="Available">
                    <span>
                      <strong>Delivery Vehicle</strong>
                      <small>Delivery arrangement for retailer supply.</small>
                    </span>
                  </label>
                  <label class="zynggi-distributor__check-card">
                    <input type="checkbox" name="contact[Capability - Sales Team]" value="Available">
                    <span>
                      <strong>Sales Team</strong>
                      <small>Salesmen or field sales network.</small>
                    </span>
                  </label>
                  <label class="zynggi-distributor__check-card">
                    <input type="checkbox" name="contact[Capability - Retail Network]" value="Available">
                    <span>
                      <strong>Retailer Network</strong>
                      <small>Existing retailers served in your market.</small>
                    </span>
                  </label>
                </div>

                <div class="zynggi-distributor__grid zynggi-distributor__grid--margin">
                  <div class="zynggi-distributor__field">
                    <label for="DistributorSalesTeam-{{ section.id }}">Sales team size</label>
                    <select id="DistributorSalesTeam-{{ section.id }}" name="contact[Sales Team Size]">
                      <option value="">Select</option>
                      <option value="None">None</option>
                      <option value="1 - 2">1 – 2</option>
                      <option value="3 - 5">3 – 5</option>
                      <option value="6 - 10">6 – 10</option>
                      <option value="10+">10+</option>
                    </select>
                  </div>
                  <div class="zynggi-distributor__field">
                    <label for="DistributorVehicle-{{ section.id }}">Delivery arrangement</label>
                    <select id="DistributorVehicle-{{ section.id }}" name="contact[Delivery Arrangement]">
                      <option value="">Select</option>
                      <option value="Own Vehicle">Own Vehicle</option>
                      <option value="Multiple Vehicles">Multiple Vehicles</option>
                      <option value="Third Party Logistics">Third Party Logistics</option>
                      <option value="Not Available Yet">Not Available Yet</option>
                    </select>
                  </div>
                  <div class="zynggi-distributor__field zynggi-distributor__field--full">
                    <label for="DistributorBrands-{{ section.id }}">FMCG / spice brands you currently handle</label>
                    <input id="DistributorBrands-{{ section.id }}" type="text" name="contact[Current Brands]" placeholder="Brands or categories you currently distribute">
                  </div>
                </div>
              </div>
            </details>

            {%- comment -%} ---- 05 — Product interest ---- {%- endcomment -%}
            <details class="zynggi-distributor__details">
              <summary>
                <span aria-hidden="true">05</span>
                <span>Zynggi products you're interested in</span>
              </summary>
              <div class="zynggi-distributor__details-body">
                <div class="zynggi-distributor__product-grid">
                  <label class="zynggi-distributor__product-card">
                    <input type="checkbox" name="contact[Product Interest]" value="Pure Spices">
                    <span><strong>Pure Spices</strong><small>Turmeric, coriander, chilli and other pure spices.</small></span>
                  </label>
                  <label class="zynggi-distributor__product-card">
                    <input type="checkbox" name="contact[Product Interest]" value="Blended Masalas">
                    <span><strong>Blended Masalas</strong><small>Everyday Indian masalas and cooking blends.</small></span>
                  </label>
                  <label class="zynggi-distributor__product-card">
                    <input type="checkbox" name="contact[Product Interest]" value="Specialty Spices">
                    <span><strong>Specialty Spices</strong><small>Specialty ingredients and flavour products.</small></span>
                  </label>
                  <label class="zynggi-distributor__product-card">
                    <input type="checkbox" name="contact[Product Interest]" value="Non-Veg Range">
                    <span><strong>Non-Veg Range</strong><small>Chicken, meat and non-vegetarian cooking masalas.</small></span>
                  </label>
                  <label class="zynggi-distributor__product-card">
                    <input type="checkbox" name="contact[Product Interest]" value="Complete Zynggi Range">
                    <span><strong>Complete Zynggi Range</strong><small>Interested in the complete Zynggi portfolio.</small></span>
                  </label>
                  <label class="zynggi-distributor__product-card">
                    <input type="checkbox" name="contact[Product Interest]" value="Other">
                    <span><strong>Other</strong><small>Another product or category you want to discuss.</small></span>
                  </label>
                </div>

                <div class="zynggi-distributor__field zynggi-distributor__field--margin">
                  <label for="DistributorProductDetails-{{ section.id }}">Specific products or SKUs</label>
                  <textarea
                    id="DistributorProductDetails-{{ section.id }}"
                    name="contact[Specific Product Interest]"
                    rows="3"
                    placeholder="Example: Garam Masala, Chana Masala, Haldi, Kashmiri Lal Mirch…"
                  ></textarea>
                </div>
              </div>
            </details>

            {%- comment -%} ---- 06 — Expected requirement ---- {%- endcomment -%}
            <details class="zynggi-distributor__details">
              <summary>
                <span aria-hidden="true">06</span>
                <span>Expected requirement</span>
              </summary>
              <div class="zynggi-distributor__details-body">
                <div class="zynggi-distributor__grid">
                  <div class="zynggi-distributor__field">
                    <label for="DistributorFrequency-{{ section.id }}">Expected order frequency</label>
                    <select id="DistributorFrequency-{{ section.id }}" name="contact[Expected Order Frequency]">
                      <option value="">Select</option>
                      <option value="One Time">One Time</option>
                      <option value="Weekly">Weekly</option>
                      <option value="Fortnightly">Fortnightly</option>
                      <option value="Monthly">Monthly</option>
                      <option value="Regular Requirement">Regular Requirement</option>
                      <option value="Not Sure">Not Sure</option>
                    </select>
                  </div>
                  <div class="zynggi-distributor__field">
                    <label for="DistributorExpectedQuantity-{{ section.id }}">Approximate quantity</label>
                    <input id="DistributorExpectedQuantity-{{ section.id }}" type="text" name="contact[Expected Quantity]" placeholder="Example: 100 kg / 500 kg / 1 Ton">
                  </div>
                  <div class="zynggi-distributor__field zynggi-distributor__field--full">
                    <label for="DistributorMonthlyPotential-{{ section.id }}">Approximate monthly business potential <span class="zynggi-distributor__optional">(optional)</span></label>
                    <input id="DistributorMonthlyPotential-{{ section.id }}" type="text" name="contact[Monthly Business Potential]" placeholder="Optional">
                  </div>
                </div>
              </div>
            </details>

            {%- comment -%} ---- 07 — Notes ---- {%- endcomment -%}
            <details class="zynggi-distributor__details">
              <summary>
                <span aria-hidden="true">07</span>
                <span>Anything else we should know</span>
              </summary>
              <div class="zynggi-distributor__details-body">
                <div class="zynggi-distributor__field">
                  <label for="DistributorPlan-{{ section.id }}">Your distribution plan <span class="zynggi-distributor__optional">(optional)</span></label>
                  <textarea
                    id="DistributorPlan-{{ section.id }}"
                    name="contact[Distribution Plan]"
                    rows="4"
                    placeholder="Target market, retailer network, areas you want to cover…"
                  ></textarea>
                </div>
                <div class="zynggi-distributor__field zynggi-distributor__field--margin">
                  <label for="DistributorAdditional-{{ section.id }}">Additional requirements or questions <span class="zynggi-distributor__optional">(optional)</span></label>
                  <textarea
                    id="DistributorAdditional-{{ section.id }}"
                    name="contact[Additional Requirements]"
                    rows="3"
                    placeholder="Anything else you'd like our team to know."
                  ></textarea>
                </div>
              </div>
            </details>

            <button type="submit" class="zynggi-distributor__submit-btn zynggi-distributor__submit-btn--alt">
              <span>Submit Full Application</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>

      {% endform %}
    </div>

    {%- comment -%} ================= CONTACT / WHATSAPP ================= {%- endcomment -%}
    <div class="zynggi-distributor__contact">
      <div>
        <span class="zynggi-distributor__label">{{ section.settings.contact_eyebrow }}</span>
        <h2>{{ section.settings.contact_heading }}</h2>
        <p>{{ section.settings.contact_text }}</p>
      </div>

      <div class="zynggi-distributor__contact-details">
        <a href="tel:+919728326350">+91 97283 26350</a>
        <a href="mailto:Contact.zynggi@gmail.com">Contact.zynggi@gmail.com</a>
        {% if section.settings.whatsapp_number != blank %}
          <a
