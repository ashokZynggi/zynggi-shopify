<script>
(function () {
  var root = document.getElementById('ZynggiDistributor-{{ section.id }}');
  if (!root) return;

  /* ---- Progressive disclosure toggle ---- */
  var toggle = root.querySelector('[data-zynggi-advanced-toggle]');
  var body = document.getElementById('DistributorAdvanced-{{ section.id }}');
  if (toggle && body) {
    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      body.hidden = open;
      if (!open) {
        // scroll into view smoothly
        setTimeout(function () {
          body.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 60);
      }
    });
  }

  /* ---- Smooth scroll to form ---- */
  root.querySelectorAll('[data-zynggi-scroll]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var target = document.querySelector(a.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  /* ---- Mobile sticky bar visibility ---- */
  var bar = root.querySelector('[data-zynggi-mobilebar]');
  var form = root.querySelector('.zynggi-distributor__application');
  if (bar && form && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        bar.classList.toggle('is-visible', !entry.isIntersecting);
      });
    }, { rootMargin: '-80px 0px 0px 0px', threshold: 0.05 });
    io.observe(form);
  }
})();
</script>

