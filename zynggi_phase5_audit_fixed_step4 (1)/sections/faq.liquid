<section class="section bg-{{ section.settings.bg }}">
  <div class="container" style="max-width:860px">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.show_search -%}<label class="visually-hidden" for="faq-q">Search questions</label><input id="faq-q" class="input" type="search" placeholder="Search questions" data-faq-search style="margin-bottom:24px">{%- endif -%}
    {%- assign cats = section.blocks | map: 'settings' | map: 'category' | uniq -%}
    {%- for cat in cats -%}
      {%- if cat != blank -%}<h3 style="margin-top:32px">{{ cat }}</h3>{%- endif -%}
      <div class="acc">
        {%- for b in section.blocks -%}{%- if b.settings.category == cat -%}
          {%- assign ans = b.settings.answer | strip_html | strip -%}
          {%- if ans != blank and ans != '[ANSWER FROM CLIENT]' and b.settings.question != blank -%}
            <details data-faq-item {{ b.shopify_attributes }}><summary>{{ b.settings.question }}</summary><div class="acc__body">{{ b.settings.answer }}</div></details>
          {%- endif -%}
        {%- endif -%}{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
  {%- assign faq_count = 0 -%}
  {%- for b in section.blocks -%}
    {%- assign ans = b.settings.answer | strip_html | strip -%}
    {%- if ans != blank and ans != '[ANSWER FROM CLIENT]' and b.settings.question != blank -%}
      {%- assign faq_count = faq_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if faq_count > 0 -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- assign faq_index = 0 -%}{%- for b in section.blocks -%}{%- assign ans = b.settings.answer | strip_html | strip -%}{%- if ans != blank and ans != '[ANSWER FROM CLIENT]' and b.settings.question != blank -%}{%- if faq_index > 0 -%},{%- endif -%}{"@type":"Question","name":{{ b.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ ans | json }}}}{%- assign faq_index = faq_index | plus: 1 -%}{%- endif -%}{%- endfor -%}]}</script>
  {%- endif -%}
</section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"},{"type":"checkbox","id":"show_search","label":"Show search box","default":false},{"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"}],"default":"white"}],
"blocks":[{"type":"qa","name":"Question","settings":[{"type":"text","id":"category","label":"Category","info":"Orders, Shipping, Payments, Products, Returns, Quality, Storage, Wholesale"},{"type":"text","id":"question","label":"Question","default":"Is this product vegetarian?"},{"type":"richtext","id":"answer","label":"Answer","default":""}]}],
"presets":[{"name":"FAQ","blocks":[{"type":"qa"},{"type":"qa","settings":{"question":"What is the shelf life?"}},{"type":"qa","settings":{"question":"How should I store it?"}}]}]}
{% endschema %}
