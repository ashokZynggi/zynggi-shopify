<section class="page-hero"{% if section.settings.image != blank %} style="position:relative;color:#fff;padding:112px 0;background:var(--c-green)"{% endif %}>
  {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '900, 1400, 1800', sizes: '100vw', alt: section.settings.heading, style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55' }}{%- endif -%}
  <div class="container" style="position:relative"><h1>{{ section.settings.heading | default: page.title }}</h1>{%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  {%- if section.settings.cta_text != blank -%}<a class="btn btn--accent" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>{%- endif -%}</div>
</section>
{% schema %}
{"name":"Page hero","settings":[{"type":"text","id":"heading","label":"Heading","default":"More than just spices"},{"type":"textarea","id":"text","label":"Text"},{"type":"image_picker","id":"image","label":"Background image"},{"type":"text","id":"cta_text","label":"Button text"},{"type":"url","id":"cta_link","label":"Button link"}],"presets":[{"name":"Page hero"}]}
{% endschema %}
