<section class="section bg-{{ section.settings.bg }} zynggi-instagram-section">
  <div class="container">

    <div class="section__head">
      <div>
        <h2>{{ section.settings.heading }}</h2>
      </div>

      {%- if settings.social_instagram != blank -%}
        <a
          class="link"
          href="{{ settings.social_instagram }}"
          rel="noopener noreferrer"
          target="_blank"
        >
          Follow on Instagram
        </a>
      {%- endif -%}
    </div>

    <div class="igrid zynggi-instagram-grid">

      {%- for block in section.blocks -%}

        {%- assign post_link = block.settings.link | default: settings.social_instagram | default: '#' -%}

        <a
          class="zynggi-instagram-post"
          href="{{ post_link }}"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="{{ block.settings.alt | default: 'View Instagram post' }}"
          {{ block.shopify_attributes }}
        >

          {%- if block.settings.image != blank -%}

            <div class="zynggi-instagram-image">

              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800',
                  sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                  alt: block.settings.alt
              }}

              <!-- Play button -->
              <span
                class="zynggi-instagram-play"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M8 5.5V18.5L18 12L8 5.5Z"
                    fill="currentColor"
                  />
                </svg>
              </span>

              <!-- Instagram icon -->
              <span
                class="zynggi-instagram-badge"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <rect
                    x="3"
                    y="3"
                    width="18"
                    height="18"
                    rx="5"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <circle
                    cx="17.3"
                    cy="6.8"
                    r="1"
                    fill="currentColor"
                  />
                </svg>
              </span>

            </div>

          {%- endif -%}

        </a>

      {%- endfor -%}

    </div>

  </div>
</section>


<style>

/* =========================================================
   ZYNGGI INSTAGRAM / REEL GRID
   ========================================================= */

.zynggi-instagram-section {
  overflow: hidden;
}


/* =========================================================
   GRID
   ========================================================= */

.zynggi-instagram-grid {
  display: grid !important;

  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 18px;

  width: 100%;
}


/* =========================================================
   POST CARD
   ========================================================= */

.zynggi-instagram-post {
  position: relative;

  display: block;

  width: 100%;

  aspect-ratio: 4 / 5;

  overflow: hidden;

  border-radius: 4px;

  text-decoration: none;

  background: #f3f0eb;

  isolation: isolate;
}


/* =========================================================
   IMAGE
   ========================================================= */

.zynggi-instagram-image {
  position: relative;

  width: 100%;
  height: 100%;

  overflow: hidden;
}


.zynggi-instagram-image img {
  display: block;

  width: 100% !important;
  height: 100% !important;

  max-width: none !important;

  object-fit: cover;

  object-position: center;

  margin: 0 !important;

  transition:
    transform 0.45s ease,
    filter 0.45s ease;
}


/* =========================================================
   HOVER
   ========================================================= */

.zynggi-instagram-post:hover
.zynggi-instagram-image img {
  transform: scale(1.035);

  filter: brightness(0.82);
}


/* =========================================================
   PLAY BUTTON
   ========================================================= */

.zynggi-instagram-play {
  position: absolute;

  top: 50%;
  left: 50%;

  transform: translate(-50%, -50%);

  width: 58px;
  height: 58px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(0, 0, 0, 0.72);

  color: #ffffff;

  box-shadow:
    0 4px 16px rgba(0, 0, 0, 0.25);

  z-index: 3;

  pointer-events: none;

  transition:
    transform 0.25s ease,
    background 0.25s ease;
}


.zynggi-instagram-play svg {
  margin-left: 3px;
}


.zynggi-instagram-post:hover
.zynggi-instagram-play {
  transform: translate(-50%, -50%) scale(1.08);

  background: rgba(0, 0, 0, 0.82);
}


/* =========================================================
   INSTAGRAM BADGE
   ========================================================= */

.zynggi-instagram-badge {
  position: absolute;

  top: 14px;
  right: 14px;

  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(0, 0, 0, 0.55);

  color: #ffffff;

  backdrop-filter: blur(5px);

  -webkit-backdrop-filter: blur(5px);

  z-index: 4;

  pointer-events: none;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 989px) {

  .zynggi-instagram-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 14px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .zynggi-instagram-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 10px;
  }


  .zynggi-instagram-post {
    border-radius: 3px;
  }


  .zynggi-instagram-play {
    width: 46px;
    height: 46px;
  }


  .zynggi-instagram-play svg {
    width: 20px;
    height: 20px;
  }


  .zynggi-instagram-badge {
    top: 9px;
    right: 9px;

    width: 28px;
    height: 28px;
  }


  .zynggi-instagram-badge svg {
    width: 15px;
    height: 15px;
  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .zynggi-instagram-image img,
  .zynggi-instagram-play {
    transition: none;
  }

}

</style>


