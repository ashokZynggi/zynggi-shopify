{%- assign b = section.settings.blog -%}
<section class="section bg-{{ section.settings.bg }}">
  <div class="container" data-carousel>
    <div class="section__head"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div>{%- if b != blank -%}<a class="link" href="{{ b.url }}">All recipes</a>{%- endif -%}</div>
    {%- if b != blank -%}
    <div class="scroller" style="grid-auto-columns:minmax(260px,calc((100% - 48px) / 3))">
      {%- for a in b.articles limit: section.settings.limit -%}
        <a class="rcard" href="{{ a.url }}">
          {%- if a.image -%}{{ a.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 990px) 30vw, 75vw', alt: a.title }}{%- endif -%}
          <div class="rcard__body">
            <h3>{{ a.title }}</h3>
            <div class="rcard__meta">
              {%- if a.metafields.custom.prep_time != blank -%}<span>{{ a.metafields.custom.prep_time }}</span>{%- endif -%}
              {%- if a.metafields.custom.difficulty != blank -%}<span>{{ a.metafields.custom.difficulty }}</span>{%- endif -%}
            </div>
            {%- assign rp = a.metafields.custom.related_products.value -%}
            {%- if rp != blank -%}<p style="margin:0 0 8px;font-size:.9rem">Flavour with <strong>{{ rp.first.title }}</strong></p>{%- endif -%}
            <span class="link">View recipe</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- else -%}<p class="muted">Choose a recipes blog in the theme editor.</p>{%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Recipe cards","settings":[
 {"type":"text","id":"heading","label":"Heading","default":"Made for your favourite recipes"},
 {"type":"text","id":"subheading","label":"Subheading"},
 {"type":"blog","id":"blog","label":"Recipes blog","info":"Articles in this blog use article metafields: prep_time, difficulty, related_products"},
 {"type":"range","id":"limit","label":"Recipes to show","min":3,"max":12,"default":6},
 {"type":"select","id":"bg","label":"Background","options":[{"value":"white","label":"White"},{"value":"warm","label":"Warm cream"},{"value":"green","label":"Deep green"}],"default":"white"}],
"presets":[{"name":"Recipe cards"}]}
{% endschema %}
