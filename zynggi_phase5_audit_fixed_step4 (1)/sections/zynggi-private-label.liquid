                type="button"
                class="zpl-advanced-toggle"
                aria-expanded="false"
                aria-controls="ZPLAdvanced-{{ section.id }}"
                data-zpl-advanced-toggle
              >
                <span class="zpl-advanced-toggle-text">
                  <strong>Want to add technical details?</strong>
                  <small>Optional — formula, processing, printing, filling, dispatch and more.</small>
                </span>
                <span class="zpl-advanced-toggle-icon" aria-hidden="true"></span>
