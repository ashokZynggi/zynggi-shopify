          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ENQUIRY -->
  <section id="private-label-enquiry" class="zpl-form-section">
    <div class="zpl-container">
      <div class="zpl-form-wrap">
        <div class="zpl-form-intro">
          {% if section.settings.form_eyebrow != blank %}
            <p class="zpl-eyebrow">{{ section.settings.form_eyebrow }}</p>
          {% endif %}

          <h2 class="zpl-heading">{{ section.settings.form_heading }}</h2>

          {% if section.settings.form_text != blank %}
            <div class="zpl-body">{{ section.settings.form_text }}</div>
          {% endif %}

          <div class="zpl-form-aside-block">
            <strong>Not sure about the specification?</strong>
            <p>That's okay. Tell us what you want to create and our team will guide you through formula, packaging and quantity.</p>
          </div>

          {% if section.settings.whatsapp_number != blank %}
            <div class="zpl-form-aside-block">
              <strong>Prefer to talk first?</strong>
              <p>We can discuss your idea on WhatsApp before you fill anything in.</p>
              <a
                class="zpl-form-wa"
                href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | default: 'Hi Zynggi, I am interested in private label spice production.' | url_encode }}"
                target="_blank" rel="noopener"
              >Chat on WhatsApp →</a>
            </div>
          {% endif %}
        </div>

        <div class="zpl-form">
          {% form 'contact', id: 'ZynggiPrivateLabelForm' %}
            {% if form.posted_successfully? %}
              <div class="zpl-success">
                {{ section.settings.success_message }}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="zpl-error">
                Please check the required fields and try again.
              </div>
            {% endif %}

            <input type="hidden" name="contact[Form Type]" value="Private Label Enquiry">

            <!-- ============ ESSENTIALS ============ -->
            <div class="zpl-form-group">
              <h3>Start your project</h3>
              <p class="zpl-group-help">Just the basics — you can add technical details after if you like.</p>

              <div class="zpl-fields">
                <div class="zpl-field">
                  <label for="ZPLFullName-{{ section.id }}">Full name *</label>
                  <input id="ZPLFullName-{{ section.id }}" type="text" name="contact[Full Name]" autocomplete="name" required>
                </div>

                <div class="zpl-field">
                  <label for="ZPLPhone-{{ section.id }}">Phone / WhatsApp *</label>
                  <input id="ZPLPhone-{{ section.id }}" type="tel" name="contact[Phone / WhatsApp]" autocomplete="tel" inputmode="tel" required>
                </div>

                <div class="zpl-field">
                  <label for="ZPLBusinessName-{{ section.id }}">Business name <span class="zpl-optional">(optional)</span></label>
                  <input id="ZPLBusinessName-{{ section.id }}" type="text" name="contact[Business Name]" autocomplete="organization">
                </div>

                <div class="zpl-field">
                  <label for="ZPLCity-{{ section.id }}">City / State <span class="zpl-optional">(optional)</span></label>
                  <input id="ZPLCity-{{ section.id }}" type="text" name="contact[City / State]" autocomplete="address-level2">
                </div>

                <div class="zpl-field">
                  <label for="ZPLBusinessType-{{ section.id }}">Business type</label>
                  <select id="ZPLBusinessType-{{ section.id }}" name="contact[Business Type]">
                    <option value="">Select</option>
                    <option value="New Spice Brand">New Spice Brand</option>
                    <option value="Existing FMCG Brand">Existing FMCG Brand</option>
                    <option value="Restaurant / Hotel">Restaurant / Hotel</option>
                    <option value="Cloud Kitchen">Cloud Kitchen</option>
                    <option value="Grocery / Retail">Grocery / Retail</option>
                    <option value="Distributor / Trader">Distributor / Trader</option>
                    <option value="Export / Trading">Export / Trading</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <div class="zpl-field">
                  <label for="ZPLProductType-{{ section.id }}">What do you want to make? *</label>
                  <select id="ZPLProductType-{{ section.id }}" name="contact[Private Label Product Type]" required>
                    <option value="">Select</option>
                    <option value="Pure Spice Powder">Pure Spice Powder</option>
                    <option value="Whole Spice">Whole Spice</option>
                    <option value="Crushed / Coarse Spice">Crushed / Coarse Spice</option>
                    <option value="Blended Masala">Blended Masala</option>
                    <option value="Herb">Herb</option>
                    <option value="Seasoning / Spice Mix">Seasoning / Spice Mix</option>
                    <option value="Custom Blend">Custom Blend</option>
                    <option value="Not Sure - Need Guidance">Not Sure — Need Guidance</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <div class="zpl-field zpl-field--full">
                  <label for="ZPLProductNames-{{ section.id }}">Product name(s) <span class="zpl-optional">(optional)</span></label>
                  <input
                    id="ZPLProductNames-{{ section.id }}"
                    type="text"
                    name="contact[Product Name(s)]"
                    placeholder="Example: Haldi, Garam Masala, Chicken Masala"
                  >
                </div>
              </div>
            </div>

            <!-- ============ QUANTITY ============ -->
            <div class="zpl-form-group">
              <fieldset class="zpl-fieldset">
                <legend class="zpl-legend">Roughly how much do you need?</legend>
                <div class="zpl-ranges">
                  <label class="zpl-range"><input type="radio" name="contact[Expected Quantity]" value="Under 500 packs"><span>Under 500 packs</span></label>
                  <label class="zpl-range"><input type="radio" name="contact[Expected Quantity]" value="500-2000 packs"><span>500–2,000 packs</span></label>
                  <label class="zpl-range"><input type="radio" name="contact[Expected Quantity]" value="2000-5000 packs"><span>2,000–5,000 packs</span></label>
                  <label class="zpl-range"><input type="radio" name="contact[Expected Quantity]" value="5000-10000 packs"><span>5,000–10,000 packs</span></label>
                  <label class="zpl-range"><input type="radio" name="contact[Expected Quantity]" value="10000+ packs"><span>10,000+ packs</span></label>
                  <label class="zpl-range"><input type="radio" name="contact[Expected Quantity]" value="By kg"><span>By kg</span></label>
                  <label class="zpl-range"><input type="radio" name="contact[Expected Quantity]" value="Not sure yet"><span>Not sure yet</span></label>
                </div>
              </fieldset>

              <div class="zpl-field zpl-field--full" style="margin-top:14px;">
                <label for="ZPLQuantityDetails-{{ section.id }}">Or enter an exact quantity <span class="zpl-optional">(optional)</span></label>
                <input
                  id="ZPLQuantityDetails-{{ section.id }}"
                  type="text"
                  name="contact[Quantity Details]"
                  placeholder="Example: 5,000 packs / 500 kg"
                >
              </div>
            </div>

            <!-- ============ FORMULA ============ -->
            <div class="zpl-form-group">
              <div class="zpl-fields">
                <div class="zpl-field">
                  <label for="ZPLFormula-{{ section.id }}">Do you already have a recipe / formula?</label>
                  <select id="ZPLFormula-{{ section.id }}" name="contact[Formula / Recipe]">
                    <option value="">Select</option>
                    <option value="I Have My Own Recipe">Yes — I have my own</option>
                    <option value="Use Zynggi Recipe">No — use a Zynggi recipe</option>
                    <option value="Need Custom Formulation">I need a custom formula</option>
                    <option value="Need Sample Development">Need sample development</option>
                    <option value="Not Sure">Not sure</option>
                  </select>
                </div>

                <div class="zpl-field">
                  <label for="ZPLPackagingType-{{ section.id }}">Do you need packaging?</label>
                  <select id="ZPLPackagingType-{{ section.id }}" name="contact[Packaging Type]">
                    <option value="">Select</option>
                    <option value="Printed Pouch">Yes — printed pouch</option>
                    <option value="Plain Pouch + Sticker / Label">Yes — plain pouch + label</option>
                    <option value="Jar + Label">Yes — jar + label</option>
                    <option value="Printed Jar / Custom Pack">Yes — printed jar / custom pack</option>
                    <option value="Bulk Packaging">Bulk packaging</option>
                    <option value="Not Sure - Need Guidance">Not sure — need guidance</option>
                  </select>
                </div>

                <div class="zpl-field zpl-field--full">
                  <label for="ZPLPackSize-{{ section.id }}">Preferred pack size(s) <span class="zpl-optional">(optional)</span></label>
                  <input
                    id="ZPLPackSize-{{ section.id }}"
                    type="text"
                    name="contact[Pack Size(s)]"
                    placeholder="Example: 50g, 100g, 200g"
                  >
                </div>

                <div class="zpl-field zpl-field--full">
                  <label for="ZPLAdditional-{{ section.id }}">Anything else we should know? <span class="zpl-optional">(optional)</span></label>
                  <textarea
                    id="ZPLAdditional-{{ section.id }}"
                    name="contact[Additional Requirements]"
                    rows="3"
                    placeholder="Target market, launch timeline, special requirements or anything else."
                  ></textarea>
                </div>
              </div>
            </div>

            <p class="zpl-form-note">
              {{ section.settings.form_note }}
            </p>

            <button type="submit" class="zpl-submit">
              <span>{{ section.settings.form_button_label }}</span>
              <span aria-hidden="true">→</span>
            </button>

            <p class="zpl-submit-note">
              No payment required. Our team will contact you with the next steps.
            </p>

            <!-- ============ OPTIONAL TECHNICAL DETAILS ============ -->
            <div class="zpl-advanced-wrap" style="margin-top:22px;">
