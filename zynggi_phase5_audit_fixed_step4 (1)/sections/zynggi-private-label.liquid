  <!-- HOW IT WORKS -->
  <section class="zpl-section zpl-section--white">
    <div class="zpl-container">
      <div class="zpl-section-header">
        {% if section.settings.steps_eyebrow != blank %}
          <p class="zpl-eyebrow">{{ section.settings.steps_eyebrow }}</p>
        {% endif %}

