{% comment %}
  Zynggi Private Label (UX/CRO redesign)
  File name: sections/zynggi-private-label.liquid

  Strategy:
  - Short primary enquiry (essentials only) → submit in <30s
  - "Add technical details" toggle reveals the full specification form
  - WhatsApp as a low-friction alternative path
  - All original contact[...] field names preserved
  - Scoped CSS — homepage untouched
{% endcomment %}

<section
  id="ZynggiPrivateLabel-{{ section.id }}"
  class="zynggi-private-label"
>
  <style>
    #ZynggiPrivateLabel-{{ section.id }} {
      --zpl-brown: #2a1a12;
      --zpl-brown-light: #4a3022;
      --zpl-cream: #f7f2e7;
      --zpl-gold: #b58a45;
      --zpl-gold-light: #d7b36d;
      --zpl-text: #2b211b;
      --zpl-muted: #75685e;
      --zpl-border: rgba(42, 26, 18, 0.12);
      color: var(--zpl-text);
      background: var(--zpl-cream);
      font-size: 16px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }

    #ZynggiPrivateLabel-{{ section.id }} *,
    #ZynggiPrivateLabel-{{ section.id }} *::before,
    #ZynggiPrivateLabel-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #ZynggiPrivateLabel-{{ section.id }} [hidden] { display: none !important; }

    #ZynggiPrivateLabel-{{ section.id }} a { text-decoration: none; }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-container {
      width: min(1200px, calc(100% - 40px));
      margin: 0 auto;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-eyebrow {
      margin: 0 0 12px;
      color: var(--zpl-gold);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-heading {
      margin: 0;
      color: inherit;
      line-height: 1.08;
      letter-spacing: -0.02em;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-body {
      margin: 18px 0 0;
      color: var(--zpl-muted);
      line-height: 1.75;
      font-size: 16px;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 52px;
      padding: 14px 26px;
      border: 0;
      border-radius: 999px;
      background: var(--zpl-gold);
      color: #fff;
      text-decoration: none;
      font: inherit;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.04em;
      cursor: pointer;
      transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-button:hover {
      transform: translateY(-2px);
      opacity: 0.94;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-button--ghost {
      background: transparent;
      color: #fff;
      border: 1px solid rgba(255,255,255,.45);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-button--ghost:hover {
      background: rgba(255,255,255,.12);
      border-color: #fff;
    }

    /* HERO */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero {
      position: relative;
      min-height: {{ section.settings.hero_min_height }}px;
      display: flex;
      align-items: center;
      overflow: hidden;
      background: var(--zpl-brown);
      color: #fff;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-media {
      position: absolute;
      inset: 0;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-media img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: {{ section.settings.hero_image_position }};
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-placeholder {
      width: 100%;
      height: 100%;
      min-height: {{ section.settings.hero_min_height }}px;
      background: linear-gradient(90deg, #241710 0%, #332116 48%, #5a3922 100%);
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-overlay {
      position: absolute;
      inset: 0;
      background: rgba(20, 12, 8, {{ section.settings.hero_overlay | divided_by: 100.0 }});
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-content {
      position: relative;
      z-index: 2;
      width: min(720px, 100%);
      padding: 80px 0;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-content .zpl-eyebrow { color: var(--zpl-gold-light); }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-content .zpl-heading {
      color: #fff;
      font-size: clamp(38px, 5.2vw, 68px);
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-content .zpl-body {
      max-width: 640px;
      color: rgba(255,255,255,.86);
      font-size: 16.5px;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-points {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      margin: 20px 0 0;
      padding: 0;
      list-style: none;
      color: rgba(255,255,255,.78);
      font-size: 12.5px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-points li { display: inline-flex; align-items: center; gap: 7px; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-points li::before {
      content: ""; width: 6px; height: 6px; border-radius: 50%;
      background: var(--zpl-gold-light);
    }

    /* INTRO */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-intro {
      padding: 80px 0 40px;
      text-align: center;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-intro .zpl-heading { font-size: clamp(30px, 4vw, 46px); }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-intro .zpl-body {
      max-width: 720px;
      margin-left: auto;
      margin-right: auto;
    }

    /* CAPABILITIES */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-section { padding: 80px 0; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-section--white { background: #fff; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-section--dark { background: var(--zpl-brown); color: #fff; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-section--dark .zpl-heading { color: #fff; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-section--dark .zpl-body { color: rgba(255,255,255,.72); }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-section-header {
      max-width: 720px;
      margin-bottom: 40px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-section-header .zpl-heading { font-size: clamp(28px, 3.6vw, 44px); }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-cap-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-cap-card {
      padding: 26px 22px;
      background: var(--zpl-cream);
      border: 1px solid var(--zpl-border);
      border-radius: 14px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-cap-num {
      margin-bottom: 14px;
      color: var(--zpl-gold);
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 0.15em;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-cap-card h3 {
      margin: 0 0 8px;
      font-size: 17px;
      line-height: 1.3;
      color: var(--zpl-brown);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-cap-card p {
      margin: 0;
      color: var(--zpl-muted);
      font-size: 13.5px;
      line-height: 1.6;
    }

    /* STEPS */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-step {
      padding: 24px 0 0;
      border-top: 1px solid var(--zpl-border);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-step-number {
      margin-bottom: 12px;
      color: var(--zpl-gold);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.15em;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-step h3 { margin: 0 0 6px; font-size: 17px; color: var(--zpl-brown); }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-step p { margin: 0; color: var(--zpl-muted); font-size: 13.5px; line-height: 1.6; }

    /* FORM SECTION */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-section {
      padding: 90px 0;
      background: #efe7d8;
      scroll-margin-top: 90px;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-wrap {
      display: grid;
      grid-template-columns: 0.72fr 1.28fr;
      gap: 50px;
      align-items: start;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-intro {
      position: sticky;
      top: 30px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-intro .zpl-heading { font-size: clamp(30px, 3.6vw, 44px); }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-aside-block {
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid var(--zpl-border);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-aside-block strong {
      display: block;
      margin-bottom: 6px;
      color: var(--zpl-brown);
      font-size: 14.5px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-aside-block p {
      margin: 0;
      color: var(--zpl-muted);
      font-size: 13.5px;
      line-height: 1.65;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-wa {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      color: var(--zpl-gold);
      font-size: 13.5px;
      font-weight: 700;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-wa:hover { text-decoration: underline; }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-form {
      padding: 30px;
      background: #fff;
      border: 1px solid var(--zpl-border);
      border-radius: 18px;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-group { margin-bottom: 28px; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-group:last-of-type { margin-bottom: 0; }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-group h3 {
      margin: 0 0 6px;
      font-size: 17px;
      color: var(--zpl-brown);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-group .zpl-group-help {
      margin: 0 0 16px;
      color: var(--zpl-muted);
      font-size: 13px;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-fields {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-field--full { grid-column: 1 / -1; }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-field label {
      display: block;
      margin-bottom: 6px;
      font-size: 13px;
      font-weight: 700;
      color: var(--zpl-text);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-optional {
      font-weight: 500;
      color: var(--zpl-muted);
      font-size: 12px;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-field input,
    #ZynggiPrivateLabel-{{ section.id }} .zpl-field select,
    #ZynggiPrivateLabel-{{ section.id }} .zpl-field textarea {
      width: 100%;
      min-height: 50px;
      padding: 13px 14px;
      border: 1px solid rgba(42, 26, 18, 0.2);
      border-radius: 11px;
      background: #fff;
      color: var(--zpl-text);
      font: inherit;
      font-size: 15px;
      outline: none;
      transition: border-color .18s ease, box-shadow .18s ease;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-field textarea {
      min-height: 100px;
      resize: vertical;
      line-height: 1.55;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-field input:focus,
    #ZynggiPrivateLabel-{{ section.id }} .zpl-field select:focus,
    #ZynggiPrivateLabel-{{ section.id }} .zpl-field textarea:focus {
      border-color: var(--zpl-gold);
      box-shadow: 0 0 0 3px rgba(181,138,69,.14);
    }

    /* Ranges */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-fieldset { margin: 0; padding: 0; border: 0; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-legend {
      padding: 0;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
      color: var(--zpl-text);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-ranges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-range {
      position: relative;
      display: inline-flex;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-range input {
      position: absolute;
      width: 1px; height: 1px;
      opacity: 0;
      margin: 0;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-range span {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 8px 16px;
      border: 1px solid var(--zpl-border);
      border-radius: 999px;
      background: #fff;
      font-size: 13.5px;
      cursor: pointer;
      transition: border-color .15s ease, background .15s ease, color .15s ease;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-range input:checked + span {
      border-color: var(--zpl-gold);
      background: var(--zpl-gold);
      color: #fff;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-range input:focus-visible + span {
      outline: 2px solid var(--zpl-gold);
      outline-offset: 2px;
    }

    /* Advanced disclosure */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      width: 100%;
      padding: 18px 20px;
      margin-top: 8px;
      border: 1px dashed var(--zpl-gold);
      border-radius: 14px;
      background: #fffaf2;
      font: inherit;
      text-align: left;
      cursor: pointer;
      transition: background .18s ease;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle:hover { background: #fff5e0; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle-text { min-width: 0; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle-text strong {
      display: block;
      color: var(--zpl-brown);
      font-size: 15px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle-text small {
      display: block;
      color: var(--zpl-muted);
      font-size: 12.5px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle-icon {
      position: relative;
      flex: 0 0 24px;
      width: 24px; height: 24px;
      border-radius: 50%;
      background: var(--zpl-gold);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle-icon::before,
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle-icon::after {
      content: "";
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%,-50%);
      background: #fff;
      border-radius: 2px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle-icon::before { width: 11px; height: 2px; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle-icon::after { width: 2px; height: 11px; transition: transform .2s ease; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-toggle[aria-expanded="true"] .zpl-advanced-toggle-icon::after {
      transform: translate(-50%,-50%) scaleY(0);
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-advanced-body { margin-top: 16px; }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-details {
      margin-bottom: 10px;
      border: 1px solid var(--zpl-border);
      border-radius: 14px;
      background: #fff;
      overflow: hidden;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-details summary {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 15px 18px;
      cursor: pointer;
      list-style: none;
      font-size: 14.5px;
      font-weight: 700;
      color: var(--zpl-brown);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-details summary::-webkit-details-marker { display: none; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-details summary > span:first-child {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 26px;
      width: 26px; height: 26px;
      border-radius: 50%;
      background: var(--zpl-gold);
      color: #fff;
      font-size: 10.5px;
      font-weight: 800;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-details[open] summary { border-bottom: 1px solid var(--zpl-border); }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-details-body { padding: 18px; }

    /* Notices */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-success,
    #ZynggiPrivateLabel-{{ section.id }} .zpl-error {
      margin-bottom: 20px;
      padding: 14px 16px;
      border-radius: 12px;
      font-size: 14px;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-success {
      background: #edf6ed;
      color: #285b2a;
      border: 1px solid #cfe5cf;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-error {
      background: #f9eaea;
      color: #7a2727;
      border: 1px solid #edcaca;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-form-note {
      margin: 0 0 18px;
      color: var(--zpl-muted);
      font-size: 12.5px;
      line-height: 1.6;
    }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-submit {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      width: 100%;
      min-height: 56px;
      padding: 15px 26px;
      border: 0;
      border-radius: 999px;
      background: var(--zpl-brown);
      color: #fff;
      font: inherit;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      transition: background .18s ease, transform .18s ease;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-submit:hover { background: var(--zpl-gold); transform: translateY(-2px); }

    #ZynggiPrivateLabel-{{ section.id }} .zpl-submit-note {
      margin: 12px 0 0;
      color: var(--zpl-muted);
      font-size: 12.5px;
      text-align: center;
    }

    /* FINAL CTA */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-final-cta {
      padding: 90px 0;
      background: #1e120d;
      color: #fff;
      text-align: center;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-final-cta .zpl-heading {
      color: #fff;
      font-size: clamp(30px, 3.8vw, 50px);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-final-cta .zpl-body {
      max-width: 640px;
      margin-left: auto;
      margin-right: auto;
      color: rgba(255,255,255,.75);
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-final-cta .zpl-button { margin-top: 26px; }

    /* MOBILE STICKY BAR */
    #ZynggiPrivateLabel-{{ section.id }} .zpl-mobilebar {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 30;
      display: none;
      align-items: center;
      gap: 8px;
      padding: 8px;
      border-radius: 999px;
      background: #fff;
      box-shadow: 0 12px 32px rgba(42,26,18,.18);
      transform: translateY(140%);
      transition: transform .25s ease;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-mobilebar.is-visible { transform: translateY(0); }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-mobilebar-wa,
    #ZynggiPrivateLabel-{{ section.id }} .zpl-mobilebar-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 18px;
      border-radius: 999px;
      font-size: 13.5px;
      font-weight: 800;
      text-decoration: none;
    }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-mobilebar-wa { flex: 0 0 auto; background: #25D366; color: #fff; }
    #ZynggiPrivateLabel-{{ section.id }} .zpl-mobilebar-cta { flex: 1 1 auto; background: var(--zpl-brown); color: #fff; }

    /* TABLET */
    @media screen and (max-width: 989px) {
      #ZynggiPrivateLabel-{{ section.id }} .zpl-cap-grid { grid-template-columns: repeat(2, 1fr); }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-steps { grid-template-columns: repeat(2, 1fr); }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-form-wrap { grid-template-columns: 1fr; gap: 32px; }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-form-intro { position: static; }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-mobilebar { display: flex; }
      #ZynggiPrivateLabel-{{ section.id }} { padding-bottom: 100px; }
    }

    /* MOBILE */
    @media screen and (max-width: 749px) {
      #ZynggiPrivateLabel-{{ section.id }} .zpl-container { width: min(100% - 28px, 1200px); }

      #ZynggiPrivateLabel-{{ section.id }} .zpl-hero { min-height: {{ section.settings.hero_mobile_height }}px; }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-placeholder { min-height: {{ section.settings.hero_mobile_height }}px; }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-content { padding: 55px 0; }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-content .zpl-heading { font-size: 34px; letter-spacing: -1px; }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-content .zpl-body { font-size: 15px; }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-cta { flex-direction: column; align-items: stretch; }
      #ZynggiPrivateLabel-{{ section.id }} .zpl-hero-cta .zpl-button { width: 100%; }

