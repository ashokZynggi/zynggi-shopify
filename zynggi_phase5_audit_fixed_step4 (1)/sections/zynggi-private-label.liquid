                      </div>
                      <div class="zpl-field">
                        <label for="ZPLBatchCoding-{{ section.id }}">Batch coding / coding requirement</label>
                        <select id="ZPLBatchCoding-{{ section.id }}" name="contact[Batch Coding Requirement]">
                          <option value="">Select</option>
                          <option value="Required">Required</option>
                          <option value="Already Arranged">Already Arranged</option>
                          <option value="Need Guidance">Need Guidance</option>
                        </select>
                      </div>
                      <div class="zpl-field">
                        <label for="ZPLDispatch-{{ section.id }}">Dispatch requirement</label>
                        <select id="ZPLDispatch-{{ section.id }}" name="contact[Dispatch Requirement]">
                          <option value="">Select</option>
                          <option value="Ready Product Dispatch">Ready Product Dispatch</option>
                          <option value="Bulk Product Dispatch">Bulk Product Dispatch</option>
                          <option value="Packaging Only">Packaging Only</option>
                          <option value="Not Sure">Not Sure</option>
                        </select>
                      </div>
                      <div class="zpl-field">
                        <label for="ZPLDeliveryLocation-{{ section.id }}">Delivery location</label>
                        <input id="ZPLDeliveryLocation-{{ section.id }}" type="text" name="contact[Delivery Location]" placeholder="City / State">
                      </div>
                      <div class="zpl-field">
                        <label for="ZPLLaunchDate-{{ section.id }}">Target launch / requirement date</label>
                        <input id="ZPLLaunchDate-{{ section.id }}" type="text" name="contact[Target Launch / Requirement Date]" placeholder="Example: November 2026">
                      </div>
                      <div class="zpl-field">
                        <label for="ZPLOrderFrequency-{{ section.id }}">Order frequency</label>
                        <select id="ZPLOrderFrequency-{{ section.id }}" name="contact[Order Frequency]">
                          <option value="">Select</option>
                          <option value="One Time">One Time</option>
                          <option value="Monthly">Monthly</option>
                          <option value="Quarterly">Quarterly</option>
                          <option value="Regular / Repeat">Regular / Repeat</option>
                          <option value="Not Sure">Not Sure</option>
                        </select>
                      </div>
                      <div class="zpl-field">
                        <label for="ZPLQuantityBasis-{{ section.id }}">Quantity basis</label>
                        <select id="ZPLQuantityBasis-{{ section.id }}" name="contact[Quantity Basis]">
                          <option value="">Select</option>
                          <option value="Number of Packs">Number of Packs</option>
                          <option value="Kilograms">Kilograms</option>
                          <option value="Both Packs and Kg">Both Packs and Kg</option>
                          <option value="Not Sure">Not Sure</option>
                        </select>
                      </div>
                    </div>

                    <button type="submit" class="zpl-submit" style="margin-top:18px;">
                      <span>Submit Full Project Details</span>
                      <span aria-hidden="true">→</span>
                    </button>
                  </div>
                </details>
              </div>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="zpl-final-cta">
    <div class="zpl-container">
      {% if section.settings.final_eyebrow != blank %}
        <p class="zpl-eyebrow">{{ section.settings.final_eyebrow }}</p>
      {% endif %}

      <h2 class="zpl-heading">{{ section.settings.final_heading }}</h2>

      {% if section.settings.final_text != blank %}
        <div class="zpl-body">{{ section.settings.final_text }}</div>
      {% endif %}

      {% if section.settings.final_button_label != blank %}
        <a
          class="zpl-button"
          href="{{ section.settings.final_button_link | default: '#private-label-enquiry' }}"
          data-zpl-scroll
        >
          {{ section.settings.final_button_label }}
        </a>
      {% endif %}
    </div>
  </section>

  <!-- MOBILE STICKY BAR -->
  <div class="zpl-mobilebar" data-zpl-mobilebar>
    {% if section.settings.whatsapp_number != blank %}
      <a
        class="zpl-mobilebar-wa"
        href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | default: 'Hi Zynggi, I am interested in private label spice production.' | url_encode }}"
        target="_blank" rel="noopener"
        aria-label="Chat on WhatsApp"
      >WhatsApp</a>
    {% endif %}
    <a class="zpl-mobilebar-cta" href="#private-label-enquiry" data-zpl-scroll>
      Start Private Label →
    </a>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('ZynggiPrivateLabel-{{ section.id }}');
  if (!root) return;

  /* Advanced toggle */
  var advToggle = root.querySelector('[data-zpl-advanced-toggle]');
  var advBody = document.getElementById('ZPLAdvanced-{{ section.id }}');
  if (advToggle && advBody) {
    advToggle.addEventListener('click', function () {
      var open = advToggle.getAttribute('aria-expanded') === 'true';
      advToggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      advBody.hidden = open;
      if (!open) {
        setTimeout(function () {
          advBody.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 60);
      }
    });
  }

  /* Smooth scroll */
  root.querySelectorAll('[data-zpl-scroll]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var target = document.querySelector(a.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  /* Mobile sticky bar visibility */
  var bar = root.querySelector('[data-zpl-mobilebar]');
  var form = root.querySelector('.zpl-form-section');
  if (bar && form && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        bar.classList.toggle('is-visible', !entry.isIntersecting);
      });
    }, { rootMargin: '-80px 0px 0px 0px', threshold: 0.05 });
    io.observe(form);
  }
})();
</script>

