        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: section.settings.hero_image.alt
        }}
      {% else %}
        <div class="zpl-hero-placeholder"></div>
      {% endif %}
