            </a>
          {% endif %}

          {% if section.settings.whatsapp_number != blank %}
            <a
              class="zpl-button zpl-button--ghost"
              href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | default: 'Hi Zynggi, I am interested in private label spice production.' | url_encode }}"
              target="_blank" rel="noopener"
            >Talk to Zynggi</a>
          {% endif %}
        </div>

        <ul class="zpl-hero-points">
          <li>No payment to enquire</li>
          <li>Not sure? We'll guide you</li>
          <li>Reply within 1 working day</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="zpl-intro">
    <div class="zpl-container">
      {% if section.settings.process_eyebrow != blank %}
        <p class="zpl-eyebrow">{{ section.settings.process_eyebrow }}</p>
      {% endif %}

      <h2 class="zpl-heading">{{ section.settings.process_heading }}</h2>

      {% if section.settings.process_text != blank %}
        <div class="zpl-body">{{ section.settings.process_text }}</div>
      {% endif %}
    </div>
  </section>

  <!-- WHAT WE CAN DO -->
  <section class="zpl-section">
    <div class="zpl-container">
      <div class="zpl-section-header">
        {% if section.settings.services_eyebrow != blank %}
          <p class="zpl-eyebrow">{{ section.settings.services_eyebrow }}</p>
        {% endif %}

