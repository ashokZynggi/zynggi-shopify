{%- liquid
  assign og_image = settings.share_image
  if og_image == blank
    if template.name == 'product'
      assign og_image = product.featured_image
    elsif template.name == 'article'
      assign og_image = article.image
    elsif template.name == 'collection' and collection.image
      assign og_image = collection.image
    else
      assign og_image = settings.favicon
    endif
  endif
  assign meta_description = page_description
  if meta_description == blank and template.name == 'index'
    assign meta_description = settings.home_meta_description | default: shop.description
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ meta_description | escape }}">
{%- if og_image -%}<meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
<meta name="twitter:description" content="{{ meta_description | escape }}">
{%- if og_image -%}<meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">{%- endif -%}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Organization",
  "name":{{ shop.name | json }},
  "url":{{ shop.url | json }}{% if settings.favicon != blank %},
  "logo":"https:{{ settings.favicon | image_url: width: 512 }}"{% endif %}{% if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_youtube != blank or settings.social_pinterest != blank %},
  "sameAs":[{% assign social_count = 0 %}{% for social in 'social_instagram,social_facebook,social_youtube,social_pinterest' | split: ',' %}{% assign social_url = settings[social] %}{% if social_url != blank %}{% if social_count > 0 %},{% endif %}{{ social_url | json }}{% assign social_count = social_count | plus: 1 %}{% endif %}{% endfor %}]
  {% endif %}
}
</script>
{%- if template.name == 'index' -%}
{%- capture search_action_target -%}{{ shop.url }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":{{ shop.name | json }},"url":{{ shop.url | json }},"potentialAction":{"@type":"SearchAction","target":{{ search_action_target | strip | json }},"query-input":"required name=search_term_string"}}
</script>
{%- endif -%}
{%- if template.name == 'product' -%}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Product",
  "name":{{ product.title | json }},
  "description":{{ product.description | strip_html | truncate: 300 | json }},
  "brand":{"@type":"Brand","name":{{ shop.name | json }}},
  "url":{{ shop.url | append: product.url | json }}{% if product.featured_image %},
  "image":["https:{{ product.featured_image | image_url: width: 1200 }}"]{% endif %},
  "offers":[{% for v in product.variants %}
    {"@type":"Offer","sku":{{ v.sku | json }},"url":{{ shop.url | append: v.url | json }},"price":{{ v.price | divided_by: 100.0 | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"availability":"{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}","itemCondition":"https://schema.org/NewCondition"}{% unless forloop.last %},{% endunless %}
  {% endfor %}]
  {% assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value %}
  {% assign review_count = product.metafields.reviews.rating_count %}
  {% if rating_value != blank and review_count != blank and review_count > 0 %},"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ rating_value | json }},"reviewCount":{{ review_count | json }}}{% endif %}
}
</script>
{%- endif -%}
{%- if template.name == 'article' -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ article.title | json }},"datePublished":{{ article.published_at | date: '%Y-%m-%d' | json }},"author":{"@type":"Person","name":{{ article.author | json }}}{% if article.image %},"image":"https:{{ article.image | image_url: width: 1200 }}"{% endif %}}
</script>
{%- endif -%}
{%- if template.name == 'product' or template.name == 'collection' or template.name == 'article' -%}
<script type="application/ld+json">
{
  "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},
  {% if template.name == 'product' %}{"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ shop.url | append: product.url | json }}}
  {% elsif template.name == 'collection' %}{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ shop.url | append: collection.url | json }}}
  {% else %}{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }},{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ shop.url | append: article.url | json }}}{% endif %}
  ]
}
</script>
{%- endif -%}
